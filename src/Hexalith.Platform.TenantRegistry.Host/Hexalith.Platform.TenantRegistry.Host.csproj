    <AssemblyName>Hexalith.EventStore</AssemblyName>
    <IsPackable>false</IsPackable>
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
    <ContainerRepository>ext-secrets-1-eventstore</ContainerRepository>
