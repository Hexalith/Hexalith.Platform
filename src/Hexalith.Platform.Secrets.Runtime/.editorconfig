# The Works consumer build treats these analyzer rules as errors for every compiled project.
# This non-packable adapter project predates that gate. Suppress only the rules that
# currently fail it; do not weaken the rules for the rest of Platform or Works.
[*.cs]
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA2007.severity = none
