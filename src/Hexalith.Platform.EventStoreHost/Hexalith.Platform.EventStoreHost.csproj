<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableContainer>true</EnableContainer>
    <ContainerRepository>eventstore</ContainerRepository>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hexalith.Platform.Identity/Hexalith.Platform.Identity.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Hexalith.Platform.Protection/Hexalith.Platform.Protection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.Platform.Composition.Tests" />
  </ItemGroup>
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <DefineConstants>$(DefineConstants);HEXALITH_PLATFORM_SOURCE_CATALOG;HEXALITH_PLATFORM_EXTENSION_SDK</DefineConstants>
  </PropertyGroup>
  <!-- Platform composition generates the declared EventStore extension bindings through the AD-4 mapping:
       project references in source mode, catalog-pinned package references in package mode. -->
  <Import Project="$(PlatformEventStoreExtensionBindings)" Condition="'$(PlatformEventStoreExtensionBindings)' != ''" />
  <!-- Compile-time SDK API constants are version-range rules: a later owner release needs no project edit. -->
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' == 'true' or ('$(HexalithEventStoreVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(HexalithEventStoreVersion)', '3.132.1')))">
    <DefineConstants>$(DefineConstants);HEXALITH_PLATFORM_TECHNICAL_CATALOG_SDK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HexalithEventStoreVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(HexalithEventStoreVersion)', '4.2.0'))"><DefineConstants>$(DefineConstants);HEXALITH_PLATFORM_EXTENSION_SDK</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' == 'true' or ('$(HexalithEventStoreVersion)' != '' and $([MSBuild]::VersionGreaterThanOrEquals('$(HexalithEventStoreVersion)', '3.129.0')))"><DefineConstants>$(DefineConstants);HEXALITH_PLATFORM_CATALOG_SDK</DefineConstants></PropertyGroup>
</Project>
