<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <EnableContainer>true</EnableContainer>
    <ContainerRepository>eventstore</ContainerRepository>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Hexalith.Platform.Identity/Hexalith.Platform.Identity.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Hexalith.Platform.Protection/Hexalith.Platform.Protection.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <DefineConstants>$(DefineConstants);HEXALITH_PLATFORM_SOURCE_CATALOG;HEXALITH_PLATFORM_EXTENSION_SDK</DefineConstants>
  </PropertyGroup>
  <!-- Platform composition generates the declared EventStore extension bindings through the AD-4 mapping:
       project references in source mode, catalog-pinned package references in package mode. -->
  <Import Project="$(PlatformEventStoreExtensionBindings)" Condition="'$(PlatformEventStoreExtensionBindings)' != ''" />
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' == 'true' or '$(HexalithEventStoreVersion)' == '3.132.1' or '$(HexalithEventStoreVersion)' == '4.0.0' or '$(HexalithEventStoreVersion)' == '4.0.2' or '$(HexalithEventStoreVersion)' == '4.0.3' or '$(HexalithEventStoreVersion)' == '4.0.4' or '$(HexalithEventStoreVersion)' == '4.1.0'">
    <DefineConstants>$(DefineConstants);HEXALITH_PLATFORM_TECHNICAL_CATALOG_SDK</DefineConstants>
  </PropertyGroup>
  <!-- Qualify exact SDK cohorts; future packages remain unqualified. -->
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' == 'true' or '$(HexalithEventStoreVersion)' == '3.129.0' or '$(HexalithEventStoreVersion)' == '3.130.0' or '$(HexalithEventStoreVersion)' == '3.130.1' or '$(HexalithEventStoreVersion)' == '3.130.2' or '$(HexalithEventStoreVersion)' == '3.132.1' or '$(HexalithEventStoreVersion)' == '3.132.2' or '$(HexalithEventStoreVersion)' == '3.133.0' or '$(HexalithEventStoreVersion)' == '4.0.0' or '$(HexalithEventStoreVersion)' == '4.0.2' or '$(HexalithEventStoreVersion)' == '4.0.3' or '$(HexalithEventStoreVersion)' == '4.0.4' or '$(HexalithEventStoreVersion)' == '4.1.0'"><DefineConstants>$(DefineConstants);HEXALITH_PLATFORM_CATALOG_SDK</DefineConstants></PropertyGroup>
  <!-- Measured signed EventStore 4.2.0 carries the extension API; unknown SDKs remain unqualified. -->
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' != 'true' and '$(HexalithEventStoreVersion)' == '4.2.0'">
    <DefineConstants>$(DefineConstants);HEXALITH_PLATFORM_EXTENSION_SDK;HEXALITH_PLATFORM_CATALOG_SDK;HEXALITH_PLATFORM_TECHNICAL_CATALOG_SDK</DefineConstants>
  </PropertyGroup>
</Project>
