<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Use the existing workspace dependency; do not initialize nested submodules. -->
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props')">$(MSBuildThisFileDirectory)../Hexalith.Builds</HexalithBuildsRoot>
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.Builds</HexalithBuildsRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../Hexalith.EventStore/src/Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)../Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.EventStore</HexalithEventStoreRoot>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(Configuration)' == 'Debug'">true</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == ''">false</UseHexalithProjectReferences>
    <!-- CI binds the two Builds assemblies to the verified published tool archive. -->
    <BuildsToolingAssemblyPath Condition="'$(HexalithBuildsPublishedToolRoot)' != ''">$(HexalithBuildsPublishedToolRoot)/Hexalith.Builds.Tooling.dll</BuildsToolingAssemblyPath>
    <BuildsEventStoreHostAssemblyPath Condition="'$(HexalithBuildsPublishedToolRoot)' != ''">$(HexalithBuildsPublishedToolRoot)/g4-host/bin/EventStoreHost/Hexalith.Builds.Module.EventStoreHost.dll</BuildsEventStoreHostAssemblyPath>
  </PropertyGroup>
</Project>
