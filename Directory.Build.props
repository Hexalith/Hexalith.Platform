<Project>
  <PropertyGroup>
    <!-- Exact authenticated historical tool manifests keep their original regression runtime.
         Reading this owning file also reaches the genuine Builds 4 child builds, whose environment is scrubbed. -->
    <_PlatformRuntimeToolManifest Condition="Exists('$(MSBuildThisFileDirectory).config/dotnet-tools.json')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory).config/dotnet-tools.json'))</_PlatformRuntimeToolManifest>
    <TargetFramework>net11.0</TargetFramework>
    <TargetFramework Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(_PlatformRuntimeToolManifest)', '&quot;hexalith\.builds\.module\.cli&quot;\s*:\s*\{\s*&quot;version&quot;\s*:\s*&quot;(4\.44\.3|4\.45\.0|4\.47\.0)&quot;'))">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Preserve centrally pinned package assemblies across libraries and ASP.NET Core hosts. -->
    <RestoreEnablePackagePruning>false</RestoreEnablePackagePruning>
    <!-- Use the existing workspace dependency; do not initialize nested submodules. -->
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../Hexalith.Builds/Props/Directory.Packages.props')">$(MSBuildThisFileDirectory)../Hexalith.Builds</HexalithBuildsRoot>
    <HexalithBuildsRoot Condition="'$(HexalithBuildsRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.Builds</HexalithBuildsRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../Hexalith.EventStore/src/Hexalith.EventStore.Contracts')">$(MSBuildThisFileDirectory)../Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithEventStoreRoot Condition="'$(HexalithEventStoreRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.EventStore</HexalithEventStoreRoot>
    <HexalithTenantsRoot Condition="'$(HexalithTenantsRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../Hexalith.Tenants/src/Hexalith.Tenants.Contracts/Hexalith.Tenants.Contracts.csproj')">$(MSBuildThisFileDirectory)../Hexalith.Tenants</HexalithTenantsRoot>
    <HexalithTenantsRoot Condition="'$(HexalithTenantsRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.Tenants</HexalithTenantsRoot>
    <HexalithMemoriesRoot Condition="'$(HexalithMemoriesRoot)' == '' and Exists('$(MSBuildThisFileDirectory)../Hexalith.Memories/src/Hexalith.Memories.Contracts/Hexalith.Memories.Contracts.csproj')">$(MSBuildThisFileDirectory)../Hexalith.Memories</HexalithMemoriesRoot>
    <HexalithMemoriesRoot Condition="'$(HexalithMemoriesRoot)' == ''">$(MSBuildThisFileDirectory)references/Hexalith.Memories</HexalithMemoriesRoot>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == '' and '$(Configuration)' == 'Debug'">true</UseHexalithProjectReferences>
    <UseHexalithProjectReferences Condition="'$(UseHexalithProjectReferences)' == ''">false</UseHexalithProjectReferences>
    <!-- CI binds the two Builds assemblies to the verified published tool archive. -->
    <BuildsToolingAssemblyPath Condition="'$(HexalithBuildsPublishedToolRoot)' != ''">$(HexalithBuildsPublishedToolRoot)/Hexalith.Builds.Tooling.dll</BuildsToolingAssemblyPath>
    <BuildsEventStoreHostAssemblyPath Condition="'$(HexalithBuildsPublishedToolRoot)' != ''">$(HexalithBuildsPublishedToolRoot)/g4-host/bin/EventStoreHost/Hexalith.Builds.Module.EventStoreHost.dll</BuildsEventStoreHostAssemblyPath>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)eng/SourceRestore.props" />
</Project>
