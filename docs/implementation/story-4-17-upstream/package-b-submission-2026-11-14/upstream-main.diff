+func (b *publishTestBroker) PublishWithDeferredConfirmWithContext(ctx context.Context, _, _ string, mandatory, immediate bool, msg amqp.Publishing) (rabbitMQConfirmation, error) {
+	b.publishes.Add(1)
+	if mandatory {
+		b.mandatory.Add(1)
+	}
+	if immediate {
+		b.immediate.Add(1)
+	}
+	if b.publish != nil {
+		return b.publish(ctx, msg)
+	}
+	return nil, nil
