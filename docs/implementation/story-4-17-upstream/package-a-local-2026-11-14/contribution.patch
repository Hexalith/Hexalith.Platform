+type rabbitMQAMQPConfirmation struct {
+	channel *rabbitMQAMQPChannel
+	tag     uint64
+}
+
+func (c *rabbitMQAMQPConfirmation) outcome(confirmation amqp.Confirmation) (bool, error) {
+	if !confirmation.Ack {
