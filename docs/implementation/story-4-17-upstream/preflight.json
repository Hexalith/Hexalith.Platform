      "body": "Backport 78808be217cc4aea768acbedd0161ab9db04a0b4 from #4698.",
      "title": "[Backport release-1.19] pubsub.rabbitmq: return error when broker NACKs a confirmed publish",
      "base": "release-1.19",
      "base_sha": "3096d3c768d9977285f63fd216a54f00e6eb67d6",
      "head": "backport-4698-to-release-1.19",
      "head_sha": "b3a54596dde1944f99483a7f5eb3f14846391f39",
      "head_repo_id": 211165922,
