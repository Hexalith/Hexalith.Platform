      "requested_reviewers": null,
      "requested_team_reviewers": null,
      "diff": "@@ -289,16 +289,25 @@ func (r *rabbitMQ) publishSync(ctx context.Context, req *pubsub.PublishRequest)\n \t// confirm will be nil if are not requesting publish confirmations\n \tif confirm != nil {\n \t\t// Blocks until the server confirms\n-\t\tok := confirm.Wait()\n-\t\tif !ok {\n-\t\t\terr = errors.New(\"did not receive confirmation of publishing\")\n+\t\tif err = confirmationError(confirm); err != nil {\n \t\t\tr.logger.Errorf(\"%s publishing to %s failed: %v\", logMessagePrefix, req.Topic, err)\n+\n+\t\t\treturn r.channel, r.connectionCount, err\n \t\t}\n \t}\n \n \treturn r.channel, r.connectionCount, nil\n }\n \n+// confirmationError waits for the broker's confirmation and returns an error if the broker did not ack the message.\n+func confirmationError(confirm interface{ Wait() bool }) error {\n+\tif !confirm.Wait() {\n+\t\treturn errors.New(\"did not receive confirmation of publishing\")\n+\t}\n+\n+\treturn nil\n+}\n+\n func (r *rabbitMQ) Publish(ctx context.Context, req *pubsub.PublishRequest) error {\n \tif r.closed.Load() {\n \t\treturn pubsub.NewTerminalError(errors.New(\"component is closed\"))\n@@ -1412,3 +1412,12 @@ func TestSubscribeForeverCancelsConsumerWhenConsumeFails(t *testing.T) {\n \t\trequire.Containsf(t, cancelled, tag, \"consumer %s was registered but never cancelled\", tag)\n \t}\n }\n+\n+type fakeConfirmation struct{ acked bool }\n+\n+func (f fakeConfirmation) Wait() bool { return f.acked }\n+\n+func TestConfirmationError(t *testing.T) {\n+\trequire.NoError(t, confirmationError(fakeConfirmation{acked: true}))\n+\trequire.Error(t, confirmationError(fakeConfirmation{acked: false}))\n+}",
