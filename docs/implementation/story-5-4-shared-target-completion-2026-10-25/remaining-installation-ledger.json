  "requiredInstallationBundles": [
    {
      "id": "NATIVE",
      "owner": "Platform infrastructure and independent storage/security owners",
      "needed": "Actual eligible existing non-AWS resources, original key/epoch/KEK mappings, pinned OpenBao metadata and credential mounts, independent authority/archive enrollment, physical all-copy non-revival and survivor-recovery originals. OpenBao deletion alone is insufficient. Ciphertext-only cross-key migration is unavailable; the implemented holder flow additionally requires independently current holder/transport/closure admission and exact retained native outcomes."
    },
    {
      "id": "AUTHORITY",
      "owner": "Independent authority/archive/recovery custodians",
      "needed": "Pre-enrolled Dapr strong-CAS heads and immutable retained archives outside application backup/restore; actual replicas, failure domains, genesis/incarnations, completion reserve, retention and two-person recovery authority. Runtime creates no genesis."
    },
    {
      "id": "TRUST",
      "owner": "Independent enrollment/security/network owners",
      "needed": "Distinct P-256 role/public anchors, installed service profiles and signing mounts, current grants/revocation and Dapr app-channel credentials; separate authorizer/control/observer and qualification executor/observer/enrollment placements. All supplied bytes must match accepted pins."
    },
    {
      "id": "RECORDING",
      "owner": "Platform/EventStore and independent recorder owners",
      "needed": "Installed restricted EventStore bound-command proof source, native authoritative reader, independent original authority, exact replay/security-log stream/event ACLs, durable replicated denial spool, recovery authority and worker installation. Source composition does not install or activate these."
    },
    {
      "id": "HOST",
      "owner": "Platform host/dependency installation owners",
      "needed": "All fourteen actual host slots and five service installations at 192.168.1.30, Branch B identity/tenant/Parties/Conversations bindings and independently issued decision authority; child owning-process composition and FR-34 engine/observer bindings."
    },
    {
      "id": "PROTECTION",
      "owner": "EventStore Maintainer and independent protection owners",
      "needed": "Complete immutable protection source/package/locked graph, installed accepted profile/roles/trust, real engine and persisted-reader ports, G1-G7 closure, physical non-revival and survivor recovery originals, complete accepted owner command."
    },
    {
      "id": "COHORT",
      "owner": "Independent qualification/installation owners",
      "needed": "Externally provisioned SQLite schemas/current accepted set and service enrollment on independently durable storage, authenticated phase owners and persisted observer, pinned exact phase command artifacts, current signed owner readiness, complete configuration/profile/plan/anchor/image inventories and independent installation proof. No source test provisions production enrollment."
    },
    {
      "id": "DATES_AND_TARGET",
      "owner": [
        "Platform Maintainer",
        "EventStore Maintainer"
      ],
      "needed": "Explicit coordinated replacement Platform/protection dates and immutable complete targets based on actual installed readiness; complete replacement acceptance and executable commands afterward. No replacement date or target is inferred."
    }
