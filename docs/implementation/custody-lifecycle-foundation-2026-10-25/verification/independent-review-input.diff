@@ -0,0 +1,79 @@
+# Requires Kubernetes native sidecar initContainers; component startup precedes daprd discovery.
+# Review template only. Native backing profile remains an uninstalled reference, not an adopted backend.
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: ${CUSTODY_WORKLOAD}
+  namespace: ${NAMESPACE}
+spec:
+  replicas: 1
+  selector:
+    matchLabels: {app: "${CUSTODY_WORKLOAD}"}
+  template:
+    metadata:
+      labels: {app: "${CUSTODY_WORKLOAD}"}
+    spec:
+      serviceAccountName: ${SCOPED_COMPONENT_SERVICE_ACCOUNT}
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 1654
+        runAsGroup: 2001
+        fsGroup: 2001
+        seccompProfile: {type: RuntimeDefault}
+      initContainers:
+        - name: custody-component
+          restartPolicy: Always
+          startupProbe:
+            exec:
+              command: [/bin/sh, -c, "test -S /var/run/custody/private/hexalithcustody.sock"]
+            periodSeconds: 1
+            failureThreshold: 60
+          image: ${COMPONENT_IMAGE}
+          command: [/bin/sh, -c]
+          args: ["umask 007; mkdir -p /var/run/custody/private; chmod 0770 /var/run/custody/private; ulimit -c 0; exec dotnet /app/Hexalith.Platform.Custody.Dapr.dll --serve /installed/profile.json"]
+          securityContext:
+            readOnlyRootFilesystem: true
+            allowPrivilegeEscalation: false
+            capabilities: {drop: [ALL]}
+          volumeMounts:
+            - {name: custody-socket, mountPath: /var/run/custody}
+            - {name: installed-profile, mountPath: /installed, readOnly: true}
+            - {name: component-credentials, mountPath: /credentials, readOnly: true}
+      containers:
+        # The owning custody application instantiates the public adapters using its local daprd.
+        # Its source composition/image are separate required installation inputs; no application is fabricated here.
+        - name: custody-application
+          image: ${CUSTODY_APPLICATION_IMAGE}
+          env:
+            - {name: DAPR_GRPC_ENDPOINT, value: "http://127.0.0.1:50001"}
+          securityContext:
+            readOnlyRootFilesystem: true
+            allowPrivilegeEscalation: false
+            capabilities: {drop: [ALL]}
+          volumeMounts:
+            - {name: application-credentials, mountPath: /application-credentials, readOnly: true}
+        - name: daprd
+          image: ${DAPR_IMAGE}
+          command: [/daprd]
+          args: [ "--mode", "kubernetes", "--app-id", "${CUSTODY_APP_ID}", "--resources-path", "/dapr-resources", "--config", "custody-private", "--max-body-size", "128Mi", "--read-buffer-size", "64Ki", "--log-level", "error"]
+          env:
+            - {name: DAPR_COMPONENTS_SOCKETS_FOLDER, value: /var/run/custody/private}
+          securityContext:
+            readOnlyRootFilesystem: true
+            allowPrivilegeEscalation: false
+            capabilities: {drop: [ALL]}
+          volumeMounts:
+            - {name: custody-socket, mountPath: /var/run/custody}
+            - {name: dapr-resources, mountPath: /dapr-resources, readOnly: true}
+      volumes:
+        - name: application-credentials
+          secret: {secretName: "${SCOPED_APPLICATION_CREDENTIAL_SECRET}"}
+        - name: custody-socket
+          emptyDir: {medium: Memory, sizeLimit: 16Mi}
+        - name: installed-profile
+          secret: {secretName: "${ENROLLED_PROFILE_SECRET}"}
+        - name: component-credentials
+          secret: {secretName: "${SCOPED_COMPONENT_CREDENTIAL_SECRET}"}
+        - name: dapr-resources
+          configMap: {name: "${PINNED_DAPR_RESOURCE_CONFIGMAP}"}
