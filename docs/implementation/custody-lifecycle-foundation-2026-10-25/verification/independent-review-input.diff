--- /dev/null
+++ b/src/Hexalith.Platform.Secrets.Runtime/DaprCustodyKeyLifecycleAuthority.cs
@@ -0,0 +1,58 @@
+using System.Text.Json;
+using Hexalith.EventStore.Contracts.Security;
+using Hexalith.Platform.Custody;
+
+namespace Hexalith.Platform.Secrets.Runtime;
+
+/// <summary>Registration locator. Local data never substitutes for the independent custody original.</summary>
+public interface ICustodyKeyRegistrationSource
+{
+    /// <summary>Locates the retained complete registration for an exact identity.</summary>
+    Task<CustodyKeyRegistration?> FindAsync(CustodyKeyObjectIdentity identity, CancellationToken cancellationToken);
+}
+
+/// <summary>Production authority over independently enrolled Dapr owner state and authenticated originals; no local journal/witness authority.</summary>
+public sealed class DaprCustodyKeyLifecycleAuthority(string tenantId, ICustodyOwnerStateAuthority owner,
+    CustodyLifecycleClient client, ICustodyKeyLifecycleProvider lifecycle, ICustodyKeyRegistrationSource registrations) : ICustodyKeyLifecycleAuthority
+{
+    /// <inheritdoc />
+    public Task<bool> AuthorizeOperationAsync(CustodyKeyObjectIdentity identity, string operationId, string method, string requestDigest,
+        CancellationToken cancellationToken = default)
+        => identity.TenantId == tenantId && CustodyBindingContract.Digest(requestDigest)
+            ? owner.AuthorizeOperationAsync(CustodyBindingContract.Hash(JsonSerializer.SerializeToUtf8Bytes(new { identity, operationId, requestDigest })), method, cancellationToken)
+            : Task.FromResult(false);
+    /// <inheritdoc />
+    public async Task<bool> VerifyRegistrationAsync(CustodyKeyRegistration registration, CancellationToken cancellationToken = default)
+    {
+        if (registration.Identity.TenantId != tenantId) return false;
+        var result = await client.LookupOriginalAsync(registration, cancellationToken: cancellationToken);
+        return result.Status == CustodyKeyLifecycleStatus.Wrapped && result.ReceiptId == registration.WrapReceiptId;
+    }
+    /// <inheritdoc />
+    public Task<bool> AuthorizeEffectAsync(CustodyKeyLifecycleRequest request, CancellationToken cancellationToken = default)
+        => AuthorizeOperationAsync(request.Identity, request.OperationId, "custody-lifecycle/" + request.Action,
+            CustodyBindingContract.Hash(JsonSerializer.SerializeToUtf8Bytes(request)), cancellationToken);
+    /// <inheritdoc />
+    public async Task<bool> VerifyOutcomeAsync(CustodyKeyLifecycleRequest request, CustodyKeyLifecycleOutcome outcome, CancellationToken cancellationToken = default)
+    {
+        if (request.Identity.TenantId != tenantId || request.Identity != outcome.Identity || request.OperationId != outcome.OperationId) return false;
+        var registration = await registrations.FindAsync(request.Identity, cancellationToken).WaitAsync(cancellationToken);
+        if (registration is null) return false;
+        var original = await lifecycle.LookupAsync(registration, request, outcome.RequestDigest, cancellationToken);
+        return original == outcome && original.Status is CustodyKeyLifecycleStatus.Pinned or CustodyKeyLifecycleStatus.Unpinned or CustodyKeyLifecycleStatus.Destroyed;
+    }
+    /// <inheritdoc />
+    public Task<bool> ValidateStateAsync(string tenant, long revision, string exactStateDigest, CancellationToken cancellationToken = default)
+        => tenant == tenantId ? owner.ValidateStateAsync(revision, exactStateDigest, cancellationToken) : Task.FromResult(false);
+    /// <inheritdoc />
+    public Task<bool> RecordRevisionAsync(string tenant, long expectedRevision, long nextRevision, string exactStateDigest,
+        CancellationToken cancellationToken = default) => Task.FromResult(false);
+    /// <inheritdoc />
+    public Task<bool> AdmitTransitionAsync(AnchoredStateTransition transition, CancellationToken cancellationToken = default) => owner.AdmitTransitionAsync(transition, cancellationToken);
+    /// <inheritdoc />
+    public Task<bool> RecordTransitionAsync(AnchoredStateTransition transition, CancellationToken cancellationToken = default) => owner.RecordTransitionAsync(transition, cancellationToken);
+    /// <inheritdoc />
+    public Task<bool> RecoverTransitionAsync(AnchoredStateTransition transition, CancellationToken cancellationToken = default) => owner.RecoverTransitionAsync(transition, cancellationToken);
+    /// <inheritdoc />
+    public Task<bool> VerifyTransitionAsync(AnchoredStateTransition transition, CancellationToken cancellationToken = default) => owner.VerifyTransitionAsync(transition, cancellationToken);
+}
diff --git a/src/Hexalith.Platform.Secrets.Runtime/DaprCustodyKeyLifecycleProvider.cs b/src/Hexalith.Platform.Secrets.Runtime/DaprCustodyKeyLifecycleProvider.cs
new file mode 100644
index 0000000..5f6da1c
--- /dev/null
+++ b/src/Hexalith.Platform.Secrets.Runtime/DaprCustodyKeyLifecycleProvider.cs
@@ -0,0 +1,47 @@
+using Hexalith.EventStore.Contracts.Security;
+using Hexalith.Platform.Custody;
+
+namespace Hexalith.Platform.Secrets.Runtime;
+
+/// <summary>Retained original manifest locator. Returned data is a hint until independently verified by custody.</summary>
+public interface ICustodyReservedManifestSource
+{
+    /// <summary>Finds the unchanged complete signed manifest at the exact original protection reservation.</summary>
+    Task<DeletionBatchConsumptionRequest?> FindAsync(string reservationReceiptId, CancellationToken cancellationToken);
+}
+
+/// <summary>Dapr lifecycle port. Interaction-root destruction always consumes its original complete manifest.</summary>
+public sealed class DaprCustodyKeyLifecycleProvider(CustodyLifecycleClient client, ICustodyReservedManifestSource originals) : ICustodyKeyLifecycleProvider
+{
+    /// <inheritdoc />
+    public Task<CustodyKeyLifecycleOutcome> ExecuteAsync(CustodyKeyRegistration registration, CustodyKeyLifecycleRequest original,
+        string requestDigest, CancellationToken cancellationToken = default) => InvokeAsync(registration, original, requestDigest, false, cancellationToken);
+    /// <inheritdoc />
+    public Task<CustodyKeyLifecycleOutcome> LookupAsync(CustodyKeyRegistration registration, CustodyKeyLifecycleRequest original,
+        string requestDigest, CancellationToken cancellationToken = default) => InvokeAsync(registration, original, requestDigest, true, cancellationToken);
+
+    private async Task<CustodyKeyLifecycleOutcome> InvokeAsync(CustodyKeyRegistration registration, CustodyKeyLifecycleRequest request,
+        string digest, bool lookup, CancellationToken token)
+    {
+        var unknown = new CustodyKeyLifecycleOutcome(request.Identity, request.OperationId, digest, CustodyKeyLifecycleStatus.Unknown);
+        try
+        {
+            if (registration.Identity != request.Identity || digest != CustodyBindingContract.Hash(System.Text.Json.JsonSerializer.SerializeToUtf8Bytes(request))) return unknown;
+            if (request.Action != CustodyKeyLifecycleAction.Destroy)
+                return lookup ? await client.LookupOriginalAsync(registration, request, token) : await client.ExecuteLifecycleAsync(registration, request, token);
+            if (request.Identity.Purpose != PlatformKeyPurpose.InteractionRootDek || !CustodyBindingContract.Text(request.ProtectionReservationReceiptId)) return unknown;
+            // The signed manifest uses the target triple. Authenticate every remaining root/lifecycle/store/contract
+            // field against the retained wrap original before projecting a target receipt onto this complete identity.
+            var wrapped = await client.LookupOriginalAsync(registration, cancellationToken: token);
+            if (wrapped.Status != CustodyKeyLifecycleStatus.Wrapped || wrapped.ReceiptId != registration.WrapReceiptId) return unknown;
+            var manifest = await originals.FindAsync(request.ProtectionReservationReceiptId!, token).WaitAsync(token);
+            var target = new ProtectionTarget(request.Identity.TenantId, request.Identity.ObjectId, request.Identity.KeyAlias);
+            if (manifest is null || !manifest.Targets.Contains(target)) return unknown;
+            var original = await client.ExecuteManifestOriginalAsync(manifest, request.ProtectionReservationReceiptId!, lookup, token);
+            var receipt = original.Result.TargetReceipts.SingleOrDefault(r => r.Target == target);
+            return original.Result.State == DeletionManifestProviderState.Consumed && receipt is not null && original.RestoreBarrierReceiptId is not null
+                ? new(request.Identity, request.OperationId, digest, CustodyKeyLifecycleStatus.Destroyed, receipt.ReceiptId, original.RestoreBarrierReceiptId) : unknown;
+        }
+        catch (Exception) { return unknown; }
+    }
+}
diff --git a/tests/Hexalith.Platform.Protection.Tests/DaprAtomicDeletionManifestProviderTests.cs b/tests/Hexalith.Platform.Protection.Tests/DaprAtomicDeletionManifestProviderTests.cs
new file mode 100644
