+
+    /// <summary>Recovers the complete signed vector together with its original restore-barrier evidence.</summary>
+    public async Task<CustodyManifestOriginal> ExecuteManifestOriginalAsync(DeletionBatchConsumptionRequest original, string reservationReceiptId,
