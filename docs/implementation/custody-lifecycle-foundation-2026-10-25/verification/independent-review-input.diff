+        => delivery is null ? new("Unknown") : new(delivery.Phase.ToString(), HoldersCompleted:
+            delivery.Phase == CustodyBindingIntentPhase.Closed && delivery.IoComplete && delivery.BuffersComplete && delivery.HolderInventoryComplete);
