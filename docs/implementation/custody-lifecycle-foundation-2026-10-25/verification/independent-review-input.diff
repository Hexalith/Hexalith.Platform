--- /dev/null
+++ b/tests/Hexalith.Platform.Protection.Tests/DaprAtomicDeletionManifestProviderTests.cs
@@ -0,0 +1,51 @@
+using System.Security.Cryptography;
+using System.Text.Json;
+using Dapr.Client;
+using Hexalith.EventStore.Contracts.Security;
+using Hexalith.Platform.Protection;
+using Hexalith.Platform.Secrets.Runtime;
+using Shouldly;
+
+namespace Hexalith.Platform.Protection.Tests;
+
+public sealed class DaprAtomicDeletionManifestProviderTests
+{
+    [Fact]
+    public async Task MissingIndependentAuthorizerKeepsCompleteManifestUnknownAndLookupNeverChangesOriginalIdentity()
+    {
+        using var signer = ECDsa.Create(ECCurve.NamedCurves.nistP256);
+        using var dapr = new DaprClientBuilder().Build();
+        var source = new AbsentAuthorizer();
+        var enrollment = new AuthorityEnrollmentV1("authority", "incarnation", "store", "profile", "trust", "anchors", new string('A', 64));
+        var client = new CustodyLifecycleClient(dapr, new Dictionary<string, string> { [CustodyLifecycleClient.LogicalRole] = "custody" },
+            "owner", JsonSerializer.Serialize(enrollment), signer.ExportSubjectPublicKeyInfoPem(), source);
+        var provider = new DaprAtomicDeletionManifestProvider(client);
+        ProtectionTarget[] targets = [new("tenant", "first", "alias"), new("tenant", "second", "alias")];
+        var capability = new DeletionBatchCapabilityV1("issuer", "audience", "tenant", "deletion", "seal", "accepted", 0, "batch",
+            DeletionBatchCapabilityIdentity.TargetManifestDigest(targets), "guard", 1, 1, 1, "key-version");
+        var original = new DeletionBatchConsumptionRequest(capability, "exact-original-signature", 2, "dispatch", 3, targets);
+        var consume = await provider.ConsumeAsync(original, "reservation", TestContext.Current.CancellationToken);
+        var lookup = await provider.LookupAsync(original, "reservation", TestContext.Current.CancellationToken);
+        consume.State.ShouldBe(DeletionManifestProviderState.Unknown); lookup.State.ShouldBe(DeletionManifestProviderState.Unknown);
+        consume.TargetReceipts.ShouldBeEmpty(); lookup.TargetReceipts.ShouldBeEmpty();
+        source.Intents.Count.ShouldBe(2);
+        source.Intents[0].Operation.ShouldBe("destroy-manifest"); source.Intents[1].Operation.ShouldBe("lookup-original");
+        source.Intents[0].OperationId.ShouldBe(source.Intents[1].OperationId);
+        source.Intents[0].RequestDigest.ShouldBe(source.Intents[1].RequestDigest);
+        source.Intents[0].RequestAttemptId.ShouldNotBe(source.Intents[1].RequestAttemptId);
+        using var body = JsonDocument.Parse(source.Intents[0].BodyJson);
+        var transmitted = body.RootElement.GetProperty("Manifest").Deserialize<CustodyBindingManifestV1>(CustodyBindingContract.Json)!;
+        transmitted.Original.Targets.ShouldBe(targets);
+        transmitted.Original.DetachedJws.ShouldBe(original.DetachedJws);
+        transmitted.SignedCanonicalPayload.ShouldBe(DeletionBatchCapabilityIdentity.CanonicalPayload(capability));
+    }
+
+    private sealed class AbsentAuthorizer : ICustodyLifecycleCallSource
+    {
+        internal List<CustodyCallIntent> Intents = [];
+        public Task<CustodyPreparedCall?> PrepareAsync(CustodyCallIntent intent, CancellationToken cancellationToken)
+        { Intents.Add(intent); return Task.FromResult<CustodyPreparedCall?>(null); }
+        public Task<CustodyCallAuthorization?> AuthorizeAsync(CustodyCallIntent intent, CustodyPreparedCall prepared, string requestSha256, CancellationToken cancellationToken)
+            => throw new InvalidOperationException("Missing source cannot authorize.");
+    }
+}
diff --git a/tests/Hexalith.Platform.Secrets.Runtime.Tests/CustodyLifecyclePublicContractTests.cs b/tests/Hexalith.Platform.Secrets.Runtime.Tests/CustodyLifecyclePublicContractTests.cs
new file mode 100644
index 0000000..aadacc1
--- /dev/null
+++ b/tests/Hexalith.Platform.Secrets.Runtime.Tests/CustodyLifecyclePublicContractTests.cs
@@ -0,0 +1,63 @@
+using System.Text.Json;
+using Hexalith.Platform.Secrets.Runtime;
+using Shouldly;
+
+namespace Hexalith.Platform.Secrets.Runtime.Tests;
+
+public sealed class CustodyLifecyclePublicContractTests
+{
+    [Fact]
+    public void OwnedKeyCannotSerializeAndDisposalClearsBorrowedBackingMemory()
+    {
+        byte[] bytes = Enumerable.Range(1, 32).Select(x => (byte)x).ToArray();
+        string encoded = Convert.ToBase64String(bytes);
+        var key = new CustodyReleasedKey(bytes);
+        var result = new CustodyKeyUseResult("Released", key);
+        JsonSerializer.Serialize(key).ShouldBe("{}");
+        JsonSerializer.Serialize(result).ShouldNotContain(encoded);
+        ReadOnlyMemory<byte> borrowed = key.Bytes;
+        key.Dispose(); key.Dispose();
+        borrowed.ToArray().ShouldBe(new byte[32]);
+        Should.Throw<ObjectDisposedException>(() => { _ = key.Bytes; });
+        JsonSerializer.Serialize(result).ShouldNotContain(encoded);
+    }
+
+    [Fact]
+    public async Task AuthorizerUsesOnlyCredentialBoundExactValueFreeIntentAndRejectsDuplicateResponseFields()
+    {
+        var transport = new PrivateTransport();
+        var client = new DaprCustodyAuthorizerClient(transport,
+            new Dictionary<string, string> { [DaprCustodyAuthorizerClient.LogicalRole] = "independent-authorizer" }, "file:/private/scoped-credential");
+        var intent = new CustodyCallIntent("unwrap", "tenant", "owner", "operation", new string('A', 64),
+            "{\"Registration\":\"opaque-registration\",\"KeyUse\":\"exact-delivery\"}", "attempt", "challenge");
+        var prepared = new CustodyPreparedCall("public-envelope", 4194304, new string('B', 64), new string('C', 64));
+        transport.Response = JsonSerializer.Serialize(prepared);
+        (await client.PrepareAsync(intent, TestContext.Current.CancellationToken)).ShouldBe(prepared);
+        string hash = new('D', 64);
+        transport.Response = JsonSerializer.Serialize(new CustodyCallAuthorization(hash, new Dictionary<string, string> { ["custody-operation-proof"] = "signed" }));
+        (await client.AuthorizeAsync(intent, prepared, hash, TestContext.Current.CancellationToken))!.RequestSha256.ShouldBe(hash);
+        transport.Calls.Count.ShouldBe(2);
+        transport.Calls.All(call => call.App == "independent-authorizer" && call.Reference == "file:/private/scoped-credential").ShouldBeTrue();
+        transport.Calls[1].Json.ShouldContain(hash);
+        transport.Calls[1].Json.ShouldNotContain("RootKey");
+        transport.Response = "{\"RequestSha256\":\"one\",\"RequestSha256\":\"two\",\"Metadata\":{}}";
+        (await client.AuthorizeAsync(intent, prepared, hash, TestContext.Current.CancellationToken)).ShouldBeNull();
+        var missing = new DaprCustodyAuthorizerClient(transport, new Dictionary<string, string>(), "file:/private/scoped-credential");
+        int count = transport.Calls.Count;
+        (await missing.PrepareAsync(intent, TestContext.Current.CancellationToken)).ShouldBeNull();
+        transport.Calls.Count.ShouldBe(count);
+    }
+
+    private sealed class PrivateTransport : ISecretsCredentialBoundDaprInvoker
+    {
+        internal string? Response;
+        internal List<(string App, string Reference, string Method, string Json)> Calls = [];
+        public Task<string?> InvokeAsync(string appId, string method, string jsonBody, CancellationToken cancellationToken)
+            => throw new InvalidOperationException("Uncredentialed fallback attempted.");
+        public Task<string?> InvokeCredentialBoundAsync(string appId, string credentialReference, string method, string jsonBody, CancellationToken cancellationToken)
+        {
+            cancellationToken.ThrowIfCancellationRequested(); Calls.Add((appId, credentialReference, method, jsonBody));
+            return Task.FromResult(Response);
+        }
+    }
+}
