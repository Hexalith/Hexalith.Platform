+using System.Security.Cryptography;
+using System.Text.Json;
+using Hexalith.EventStore.Contracts.Security;
+
+namespace Hexalith.Platform.Protection;
+
+/// <summary>Exact immutable archive access within the same snapshot-excluded ERC. Unreferenced/prewritten nodes confer no completion authority.</summary>
+internal static class ErasureRootArchives
+{
+    internal const int ChunkBytes = 4 * 1024 * 1024;
+    internal const int MaximumOriginalBytes = 48 * 1024 * 1024;
+    internal static async Task<byte[]?> ReadBytesAsync(IErasureRootStore store, string tenant, string id, CancellationToken token)
+    {
+        byte[]? bytes = await store.ReadArchiveAsync(tenant, id, token).ConfigureAwait(false);
+        if (bytes is null) { return null; }
+        if (Convert.ToHexString(SHA256.HashData(bytes)) == id) { return bytes; }
+        var frame = JsonSerializer.Deserialize<ErasureRootChunkedArchive>(bytes, ErasureRootCustody.Json)
+            ?? throw new InvalidOperationException("Missing ERC archive frame.");
+        if (frame.Format != "erc-chunks-v1" || frame.Length is <= ChunkBytes or > MaximumOriginalBytes
+            || frame.Chunks.Length != (frame.Length + ChunkBytes - 1) / ChunkBytes) { throw new InvalidOperationException("Invalid ERC archive frame."); }
+        byte[] original = new byte[frame.Length];
+        int offset = 0;
+        foreach (string chunkId in frame.Chunks)
+        {
+            byte[] chunk = await store.ReadArchiveAsync(tenant, chunkId, token).ConfigureAwait(false) ?? throw new InvalidOperationException("Missing ERC archive chunk.");
+            if (chunk.Length != Math.Min(ChunkBytes, frame.Length - offset) || Convert.ToHexString(SHA256.HashData(chunk)) != chunkId)
+            { throw new InvalidOperationException("ERC archive chunk identity conflict."); }
+            chunk.CopyTo(original, offset); offset += chunk.Length;
+        }
+        if (Convert.ToHexString(SHA256.HashData(original)) != id) { throw new InvalidOperationException("ERC original identity conflict."); }
+        return original;
+    }
+    internal static async Task<SortedDictionary<string, AnchoredStateTransition>> ReadTransitionsAsync(IErasureRootStore store,
+        string tenant, string scope, ErasureRootAnchor anchor, bool history, CancellationToken token)
+    {
+        var result = new SortedDictionary<string, AnchoredStateTransition>(StringComparer.Ordinal);
+        if (anchor.ArchiveHead is null)
+        {
+            foreach (var pair in anchor.Completed) { result.Add(pair.Key, pair.Value); }
+            return result;
+        }
+        long expected = anchor.ArchiveRevision;
+        string? pointer = anchor.ArchiveHead;
+        string? digest = anchor.ArchiveRevision == anchor.Revision ? anchor.Digest : null;
+        var visited = new HashSet<string>(StringComparer.Ordinal);
+        while (pointer is not null)
+        {
+            if (!visited.Add(pointer)) { throw new InvalidOperationException("Cyclic ERC archive."); }
+            var bytes = await ReadBytesAsync(store, tenant, pointer, token).ConfigureAwait(false) ?? throw new InvalidOperationException("Committed ERC archive unavailable.");
+            var node = JsonSerializer.Deserialize<ErasureRootTransitionArchive>(bytes, ErasureRootCustody.Json) ?? throw new InvalidOperationException("Malformed ERC archive.");
+            var original = node.Original;
+            if (pointer != ErasureRootCustody.Hash(node) || node.ScopeId != scope || original.ScopeId != scope
+                || original.TargetRevision != expected || original.ExpectedRevision != expected - 1
+                || Convert.ToHexString(SHA256.HashData(original.TargetBytes)) != original.TargetDigest
+                || digest is not null && original.TargetDigest != digest) { throw new InvalidOperationException("ERC archive ancestry conflict."); }
+            result.Add(ErasureRootCustody.Hash(original), original);
+            if (!history) { break; }
+            expected--; digest = original.PredecessorDigest; pointer = node.Previous;
+        }
+        if (history && expected != 0) { throw new InvalidOperationException("Incomplete ERC archive ancestry."); }
+        return result;
+    }
+    internal static async Task<string> WriteAsync<T>(IErasureRootStore store, string tenant, T value, CancellationToken token)
+    {
+        string id = ErasureRootCustody.Hash(value);
+        byte[] bytes = JsonSerializer.SerializeToUtf8Bytes(value, ErasureRootCustody.Json);
+        if (bytes.Length > MaximumOriginalBytes) { throw new InvalidOperationException("Bounded ERC original exceeded."); }
+        if (bytes.Length > ChunkBytes)
+        {
+            var chunks = new List<string>();
+            for (int offset = 0; offset < bytes.Length; offset += ChunkBytes)
+            {
+                byte[] chunk = bytes.AsSpan(offset, Math.Min(ChunkBytes, bytes.Length - offset)).ToArray();
+                string chunkId = Convert.ToHexString(SHA256.HashData(chunk));
+                if (!await store.CreateArchiveAsync(tenant, chunkId, chunk, token).ConfigureAwait(false)) { throw new InvalidOperationException("ERC immutable chunk conflict."); }
+                chunks.Add(chunkId);
+            }
+            bytes = JsonSerializer.SerializeToUtf8Bytes(new ErasureRootChunkedArchive("erc-chunks-v1", bytes.Length, chunks.ToArray()));
+        }
+        if (!await store.CreateArchiveAsync(tenant, id, bytes, token).ConfigureAwait(false)) { throw new InvalidOperationException("ERC immutable archive conflict."); }
+        return id;
+    }
+}
