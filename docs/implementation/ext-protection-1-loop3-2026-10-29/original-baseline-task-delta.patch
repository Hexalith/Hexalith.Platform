+using Microsoft.Extensions.Hosting;
+
+namespace Hexalith.Platform.Protection;
+
+/// <summary>Owning source-receiver lifetime completion of its own disposed verifier instances, independent of any EventStore host custody instance.</summary>
+public sealed class ErasureRootVerifierHolderCompletionWorker(ErasureRootNativeOccurrenceSource source) : BackgroundService
+{
+    /// <inheritdoc />
+    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
+    {
+        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250));
+        while (await timer.WaitForNextTickAsync(stoppingToken).ConfigureAwait(false))
+        {
+            try { await source.CompleteDisposedVerifierHoldersAsync(stoppingToken).ConfigureAwait(false); }
+            catch (OperationCanceledException) when (stoppingToken.IsCancellationRequested) { break; }
+            catch (Exception) { /* This exact receiver-owned cleared instance remains queued through outage or withdrawn permission. */ }
+        }
+    }
+}
