+    {
+        ArgumentNullException.ThrowIfNull(original);
+        ArgumentNullException.ThrowIfNull(sealedResult);
+        ArgumentNullException.ThrowIfNull(ownedRoot);
+        ArgumentNullException.ThrowIfNull(digestKey);
