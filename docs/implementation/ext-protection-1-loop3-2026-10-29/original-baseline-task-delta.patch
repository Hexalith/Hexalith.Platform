+            }
+            await Console.OpenStandardOutput().WriteAsync(output, budget.Token).ConfigureAwait(false);
+            return 0;
+        }
+        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { throw; }
+        catch (Exception)
