+{
+  "schema": "ext-secrets-1-f2f3-schedule/v1",
+  "disposition": "ProposedNotExecuted",
+  "originalSchedules": 1,
+  "orderedSteps": [
+    {
+      "phase": "P0",
+      "action": "Bind approved resource identities, USD ceiling, independent roles/trust, exact artifacts/plan, retention, accepted transport and measured closure/capacity",
+      "stop": "Any null/unapproved/unverified input"
+    },
+    {
+      "phase": "P1",
+      "action": "Retain exact originals/attempt identities; independently enroll one current authority and exact EventStore owner genesis outside app restore cut",
+      "stop": "Restored/absent local state or authority replacement"
+    },
+    {
+      "phase": "P2",
+      "action": "Admit small held/target/survivor roots and separate complete 1000-target lane, registered copy/holder inventories before every effect",
+      "stop": "Capacity reserve, unregistered holder, export overlap or unknown native identity"
+    },
+    {
+      "phase": "B0-B1",
+      "action": "Guard durable hold-reservation handoff and exact owner protection reservation; one complete-manifest custody CAS freeze",
+      "stop": "Effective/unknown earlier pin, unknown ordering or changed original"
+    },
+    {
+      "phase": "B2-B3",
+      "action": "Drain holders/native producers; taint/retire sole permitted candidate; copy only survivors; independently prove alternate deletion and survivor recovery; CAS adopt successor",
+      "stop": "Any unresolved sender/buffer/copy/generation or stale head"
+    },
+    {
+      "phase": "B4",
+      "action": "Commit original native cut intent once and schedule sole source deletion; lookup and separately authorized recovery after loss; never resend SendCommitted",
+      "stop": "Unknown result retains original, no new destructive identity"
+    },
+    {
+      "phase": "B5",
+      "action": "Collect independent final deletion evidence, complete all-copy/holder closure, independent survivor recovery and restore barrier; verify original signature/full ordered vector before publication",
+      "stop": "Schedule acknowledgement, missing key, disabled key or synthetic proof"
+    },
+    {
+      "phase": "RESTORE",
+      "action": "Restore old app/checkpoint/encrypted key/receipt/config copies; verify same independent authority rejects substitutes/root reissue and all targets fail while survivors recover",
+      "stop": "Any target revival, survivor loss, old authority adoption or replacement original"
+    },
+    {
+      "phase": "FAULTS",
+      "action": "Within same original schedule inject SDK/sidecar/component/UDS loss, duplicates/cancellation, delayed I/O and object/CAS acknowledgement loss; authenticate exact result/page recovery",
+      "stop": "Unclosed holder or extra epoch/cycle/target-set"
+    },
+    {
+      "phase": "CLEANUP",
+      "action": "Independent observer journals every exact retained/deleted resource and verifies retention, no revival and survivor recovery",
+      "stop": "Uncertain resource is retained and reported; no journal erasure"
+    }
+  ],
+  "nativeExecuted": false,
+  "cohortExecuted": false,
+  "agentsConsumersExecuted": false
