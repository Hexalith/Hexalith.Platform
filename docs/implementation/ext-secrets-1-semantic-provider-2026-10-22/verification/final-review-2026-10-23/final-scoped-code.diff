+        finally { if (request.WrapInput is { } input) CryptographicOperations.ZeroMemory(input.RootKey); }
+    }
+    private async Task<CustodyBindingResponseV1> InvokeDecodedAsync(CustodyBindingRequestV1 request, byte[] exactBytes,
