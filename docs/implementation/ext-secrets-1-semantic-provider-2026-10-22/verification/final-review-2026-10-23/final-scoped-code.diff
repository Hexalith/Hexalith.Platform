new file mode 100644
index 0000000..d321fb8
--- /dev/null
+++ b/infrastructure/Hexalith.Platform.Custody.Dapr/AuthorityModel.cs
@@ -0,0 +1,54 @@
+using System.Security.Cryptography;
+using System.Text.Json;
+using Hexalith.Platform.Custody;
+using Hexalith.EventStore.Contracts.Security;
+using Hexalith.Platform.Secrets.Runtime;
+
+namespace Hexalith.Platform.Custody.Dapr;
+
+internal sealed record ObjectVersion(string Key, string VersionId, string Sha256, int Bytes, DateTimeOffset RetainUntil);
+internal sealed record AuthorityHead(long Revision, string Digest, ObjectVersion Checkpoint, string EnrollmentDigest);
+internal sealed record StoredOriginal(string RequestDigest, string Operation, ObjectVersion? Response, CustodyBindingRequestV1? Manifest);
+internal sealed record StoredRegistration(CustodyKeyRegistration Registration, OuterEnvelopeV1 Envelope, byte[] EncryptedOuterKey, string Epoch);
+internal sealed record Pin(string HoldId, string Target, long GuardRevision, string GuardReceipt);
+internal enum CyclePhase { Reserved, Prepared, RetiringSuccessor, Armed, SendCommitted, AwaitingFinalEvidence, Published }
+internal sealed record Cycle(string OperationId, CustodyBindingRequestV1 Manifest, string SourceEpoch, string? SuccessorEpoch,
+    CyclePhase Phase, string[] AlternateEpochs, string[] TaintedEpochs, string? PreparationDigest, string? CutIntentId);
+internal sealed record Anchor(long Revision, string Digest, AnchoredStateTransition? Admitted, string? AdmissionOperationId);
+
+// Only complete immutable snapshots are selected by the single conditional head. No target shards.
+internal sealed record Checkpoint(string TenantId, string EnrollmentDigest, long Revision, string PredecessorDigest,
+    string CurrentEpoch, Dictionary<string, StoredRegistration> Registrations, HashSet<string> AllocationExclusions,
+    Dictionary<string, Pin> Pins, Dictionary<string, StoredOriginal> Originals, Dictionary<string, NativeIntentV1> NativeIntents,
+    Dictionary<string, Anchor> Anchors, Cycle? Cycle, HashSet<string> RevokedSignerIds,
+    Dictionary<string, ObjectVersion> NativeResults, Dictionary<string, CustodyBindingDeliveryV1> Deliveries)
+{
+    internal bool Frozen => Cycle?.Phase is CyclePhase.Reserved or CyclePhase.Prepared or CyclePhase.RetiringSuccessor;
+}
+internal sealed record CurrentState(AuthorityHead Head, Checkpoint Checkpoint, string? ExactHeadAttribute = null, CheckpointArchiveV1? Archive = null);
+internal sealed class AuthorityUnavailableException(string message) : Exception(message);
+internal sealed class AuthorityConflictException() : Exception("Current authority comparison failed.");
+
+internal interface IAuthorityStore
+{
+    Task<CurrentState> ReadAsync(string tenant, CancellationToken cancellationToken);
+    Task<ObjectVersion> PutImmutableAsync(ReadOnlyMemory<byte> bytes, string category, CancellationToken cancellationToken);
+    Task<byte[]> ReadImmutableAsync(ObjectVersion version, CancellationToken cancellationToken);
+    Task<ObjectVersion> PutIntentResultAsync(ReadOnlyMemory<byte> bytes, string locator, CancellationToken cancellationToken);
+    Task<ObjectVersion?> FindIntentResultAsync(string locator, CancellationToken cancellationToken);
+    Task<CurrentState> CommitAsync(CurrentState expected, Checkpoint next, CancellationToken cancellationToken);
+}
+internal static class CustodyJson
+{
+    internal static byte[] Bytes<T>(T value) => JsonSerializer.SerializeToUtf8Bytes(value, CustodyBindingContract.Json);
+    internal static T Read<T>(ReadOnlySpan<byte> bytes)
+    {
+        CustodyBindingContract.RejectDuplicateProperties(bytes);
+        return JsonSerializer.Deserialize<T>(bytes, CustodyBindingContract.Json) ?? throw new AuthorityUnavailableException("Missing immutable object.");
+    }
+    internal static string Hash(ReadOnlySpan<byte> bytes) => Convert.ToHexString(SHA256.HashData(bytes));
+    internal static string Target(CustodyKeyObjectIdentity i) => CustodyJson.Hash(PlatformCanonicalBytes.Components([i.TenantId, i.ObjectId, i.KeyAlias]));
+    internal static string Interaction(CustodyKeyObjectIdentity i) => CustodyJson.Hash(PlatformCanonicalBytes.Components([i.TenantId, i.ObjectId]));
+    internal static string DeliveryId(CustodyBindingKeyUseV1 use) => Hash(PlatformCanonicalBytes.Components([use.KeyUseLeaseId, use.DeliveryAttemptId]));
+    internal static string IntentLocator(string tenant, string intent) => "journal/native-result/" + Hash(PlatformCanonicalBytes.Components([tenant, intent]));
+}
diff --git a/infrastructure/Hexalith.Platform.Custody.Dapr/AwsAuthorityStore.cs b/infrastructure/Hexalith.Platform.Custody.Dapr/AwsAuthorityStore.cs
new file mode 100644
index 0000000..2a084a6
--- /dev/null
+++ b/infrastructure/Hexalith.Platform.Custody.Dapr/AwsAuthorityStore.cs
@@ -0,0 +1,140 @@
+using Amazon.DynamoDBv2;
+using Amazon.DynamoDBv2.Model;
+using Amazon.S3;
+using Amazon.S3.Model;
+using Hexalith.Platform.Secrets.Runtime;
+
+namespace Hexalith.Platform.Custody.Dapr;
+
+// Native dependencies stop here. No create, restore, delete, TTL, or enrollment API exists on this store.
+internal sealed class AwsAuthorityStore(ComponentProfile profile, IAmazonDynamoDB dynamo, IAmazonS3 s3, TimeProvider clock) : IAuthorityStore
+{
+    internal async Task VerifyIdentityAsync(CancellationToken token)
+    {
+        var description = await dynamo.DescribeTableAsync(new DescribeTableRequest { TableName = profile.TableArn }, token);
+        var table = description.Table;
+        if (table?.TableId != profile.TableId || table.TableArn != profile.TableArn || table.TableStatus != TableStatus.ACTIVE
+            || table.Replicas is { Count: > 0 } || table.RestoreSummary?.RestoreInProgress == true)
+            throw new AuthorityUnavailableException("Authority table incarnation changed or unavailable.");
+        foreach (var bucket in new[] { profile.Checkpoints, profile.Originals })
+        {
+            var versioning = await s3.GetBucketVersioningAsync(new GetBucketVersioningRequest { BucketName = bucket.Name, ExpectedBucketOwner = bucket.OwnerAccountId }, token);
+            if (versioning.VersioningConfig?.Status != VersionStatus.Enabled) throw new AuthorityUnavailableException("Archive versioning is not enabled.");
+            var enrolled = new ObjectVersion(bucket.EnrollmentKey, bucket.EnrollmentVersion, bucket.EnrollmentSha256, -1, profile.RetainUntil);
+            _ = await ReadObjectAsync(bucket, enrolled, token);
+        }
+    }
+    public async Task<CurrentState> ReadAsync(string tenant, CancellationToken token)
+    {
+        if (!profile.Tenants.Contains(tenant, StringComparer.Ordinal)) throw new AuthorityUnavailableException("Tenant not enrolled.");
+        await VerifyIdentityAsync(token);
+        var result = await dynamo.GetItemAsync(new GetItemRequest { TableName = profile.TableArn, Key = Key(tenant), ConsistentRead = true }, token);
+        if (result.Item is null || !result.Item.TryGetValue("head", out var value) || string.IsNullOrWhiteSpace(value.S))
+            throw new AuthorityUnavailableException("Surviving authority missing; genesis is never bootstrapped.");
+        var head = CustodyJson.Read<AuthorityHead>(System.Text.Encoding.UTF8.GetBytes(value.S));
+        byte[] archiveBytes = await ReadImmutableAsync(head.Checkpoint, token);
+        var archive = CustodyJson.Read<CheckpointArchiveV1>(archiveBytes);
+        var checkpoint = await CheckpointArchive.DecodeAsync(archiveBytes, ReadImmutableAsync, token);
+        if (head.EnrollmentDigest != profile.EnrollmentDigest || checkpoint.EnrollmentDigest != profile.EnrollmentDigest
+            || head.Revision != checkpoint.Revision || head.Digest != head.Checkpoint.Sha256 || checkpoint.TenantId != tenant)
+            throw new AuthorityUnavailableException("Current authority binding mismatch.");
+        return new(head, checkpoint, value.S, archive);
+    }
+    public async Task<ObjectVersion> PutImmutableAsync(ReadOnlyMemory<byte> bytes, string category, CancellationToken token)
+        => await PutAtAsync(bytes, category, category + "/" + Guid.NewGuid().ToString("N") + "/" + CustodyJson.Hash(bytes.Span), token);
+    public Task<ObjectVersion> PutIntentResultAsync(ReadOnlyMemory<byte> bytes, string locator, CancellationToken token)
+    {
+        if (!locator.StartsWith("journal/native-result/", StringComparison.Ordinal)) throw new AuthorityUnavailableException("Invalid native-result locator.");
+        return PutAtAsync(bytes, "journal", locator, token);
+    }
+    public async Task<ObjectVersion?> FindIntentResultAsync(string locator, CancellationToken token)
+    {
+        if (!locator.StartsWith("journal/native-result/", StringComparison.Ordinal)) throw new AuthorityUnavailableException("Invalid native-result locator.");
+        try
+        {
+            using var result = await s3.GetObjectAsync(new GetObjectRequest { BucketName = profile.Originals.Name,
+                ExpectedBucketOwner = profile.Originals.OwnerAccountId, Key = locator }, token);
+            if (result.ContentLength is <= 0 or > CustodyBindingContract.MaximumOriginalBytes) throw new AuthorityUnavailableException("Result bounds invalid.");
+            using var output = new MemoryStream(); await result.ResponseStream.CopyToAsync(output, token);
+            if (output.Length != result.ContentLength) throw new AuthorityUnavailableException("Native result length mismatch.");
+            var version = new ObjectVersion(locator, result.VersionId, CustodyJson.Hash(output.ToArray()), (int)output.Length, profile.RetainUntil);
+            _ = await ReadObjectAsync(profile.Originals, version, token);
+            return version;
+        }
+        catch (AmazonS3Exception e) when (e.StatusCode == System.Net.HttpStatusCode.NotFound) { return null; }
+    }
+    private async Task<ObjectVersion> PutAtAsync(ReadOnlyMemory<byte> bytes, string category, string key, CancellationToken token)
+    {
+        if (category is not ("checkpoint" or "original" or "journal") || bytes.Length is 0 or > CustodyBindingContract.MaximumOriginalBytes
+            || profile.RetainUntil <= clock.GetUtcNow()) throw new AuthorityUnavailableException("Immutable retention or bounds unavailable.");
+        BucketIdentity bucket = category == "checkpoint" ? profile.Checkpoints : profile.Originals;
+        string hash = CustodyJson.Hash(bytes.Span);
+        using var input = new MemoryStream(bytes.ToArray(), writable: false);
+        // No multipart writes and no retries: an unacknowledged version is an orphan journal, never current.
+        var result = await s3.PutObjectAsync(new PutObjectRequest {
+            BucketName = bucket.Name, ExpectedBucketOwner = bucket.OwnerAccountId, Key = key, InputStream = input,
+            IfNoneMatch = "*", AutoCloseStream = false, ContentType = "application/json", ChecksumSHA256 = Convert.ToBase64String(System.Security.Cryptography.SHA256.HashData(bytes.Span)),
+            ObjectLockMode = ObjectLockMode.Compliance, ObjectLockRetainUntilDate = profile.RetainUntil.UtcDateTime,
+            ServerSideEncryptionMethod = ServerSideEncryptionMethod.AES256,
+        }, token);
+        if (string.IsNullOrWhiteSpace(result.VersionId) || result.VersionId == "null") throw new AuthorityUnavailableException("Immutable version missing.");
+        var version = new ObjectVersion(key, result.VersionId, hash, bytes.Length, profile.RetainUntil);
+        _ = await ReadObjectAsync(bucket, version, token);
+        return version;
+    }
+    public Task<byte[]> ReadImmutableAsync(ObjectVersion version, CancellationToken token)
+        => ReadObjectAsync(version.Key.StartsWith("checkpoint/", StringComparison.Ordinal) ? profile.Checkpoints : profile.Originals, version, token);
+    private async Task<byte[]> ReadObjectAsync(BucketIdentity bucket, ObjectVersion version, CancellationToken token)
+    {
+        if (string.IsNullOrWhiteSpace(version.VersionId) || version.VersionId == "null" || !CustodyBindingContract.Digest(version.Sha256))
+            throw new AuthorityUnavailableException("Unpinned archive version.");
+        using var result = await s3.GetObjectAsync(new GetObjectRequest { BucketName = bucket.Name, ExpectedBucketOwner = bucket.OwnerAccountId,
+            Key = version.Key, VersionId = version.VersionId }, token);
+        if (result.VersionId != version.VersionId || result.ContentLength is <= 0 or > CustodyBindingContract.MaximumOriginalBytes
+            || version.Bytes >= 0 && result.ContentLength != version.Bytes || result.ObjectLockMode != ObjectLockMode.Compliance
+            || result.ObjectLockRetainUntilDate < version.RetainUntil.UtcDateTime || result.ObjectLockRetainUntilDate <= clock.GetUtcNow().UtcDateTime)
+            throw new AuthorityUnavailableException("Immutable version/retention verification failed.");
+        using var output = new MemoryStream();
+        var buffer = new byte[64 * 1024]; int read;
+        while ((read = await result.ResponseStream.ReadAsync(buffer, token)) != 0)
+        {
+            if (output.Length + read > CustodyBindingContract.MaximumOriginalBytes) throw new AuthorityUnavailableException("Archive too large.");
+            output.Write(buffer, 0, read);
+        }
+        byte[] bytes = output.ToArray();
+        if (CustodyJson.Hash(bytes) != version.Sha256) throw new AuthorityUnavailableException("Immutable hash mismatch.");
+        return bytes;
+    }
+    public async Task<CurrentState> CommitAsync(CurrentState expected, Checkpoint next, CancellationToken token)
+    {
+        if (next.TenantId != expected.Checkpoint.TenantId || next.EnrollmentDigest != profile.EnrollmentDigest
+            || next.Revision != checked(expected.Head.Revision + 1) || next.PredecessorDigest != expected.Head.Digest)
+            throw new AuthorityUnavailableException("Invalid forward authority transition.");
+        if (string.IsNullOrWhiteSpace(expected.ExactHeadAttribute) || expected.Archive is null)
+            throw new AuthorityUnavailableException("Exact previously read authority head/archive required.");
+        bool admission = next.Originals.Count > expected.Checkpoint.Originals.Count || next.Deliveries.Count > expected.Checkpoint.Deliveries.Count
+            || next.NativeIntents.Count > expected.Checkpoint.NativeIntents.Count || next.AllocationExclusions.Count > expected.Checkpoint.AllocationExclusions.Count;
+        long ceiling = 32 * 1024 * 1024 - (admission ? profile.CompletionReserveBytes : 0);
+        if (next.Registrations.Count > 1000 || next.Originals.Count > 10000 || next.Deliveries.Count > 10000 || next.NativeIntents.Count > 10000 || next.Anchors.Count > 10000)
+            throw new AuthorityUnavailableException("Finite capacity exhausted; retained facts cannot be evicted.");
+        var plan = CheckpointArchive.Prepare(next, expected.Archive, ceiling);
+        byte[] bytes = await CheckpointArchive.WriteAsync(plan, PutImmutableAsync, token);
+        var version = await PutImmutableAsync(bytes, "checkpoint", token);
+        var head = new AuthorityHead(next.Revision, version.Sha256, version, profile.EnrollmentDigest);
+        await VerifyIdentityAsync(token);
+        try
+        {
+            await dynamo.UpdateItemAsync(new UpdateItemRequest {
+                TableName = profile.TableArn, Key = Key(next.TenantId), ConditionExpression = "#head = :previous",
+                UpdateExpression = "SET #head = :next", ExpressionAttributeNames = new() { ["#head"] = "head" },
+                ExpressionAttributeValues = new() { [":previous"] = new AttributeValue { S = expected.ExactHeadAttribute },
+                    [":next"] = new AttributeValue { S = System.Text.Encoding.UTF8.GetString(CustodyJson.Bytes(head)) } },
+            }, token);
+        }
+        catch (ConditionalCheckFailedException) { throw new AuthorityConflictException(); }
+        // Lost acknowledgement is not retried. The next invocation reads the surviving head.
+        return new(head, next, System.Text.Encoding.UTF8.GetString(CustodyJson.Bytes(head)), CustodyJson.Read<CheckpointArchiveV1>(bytes));
+    }
+    private Dictionary<string, AttributeValue> Key(string tenant) => new() {
+        ["authorityTenant"] = new AttributeValue { S = profile.Enrollment.AuthorityId + ":" + CustodyJson.Hash(System.Text.Encoding.UTF8.GetBytes(tenant)) } };
+}
diff --git a/infrastructure/Hexalith.Platform.Custody.Dapr/AwsEpochOperations.cs b/infrastructure/Hexalith.Platform.Custody.Dapr/AwsEpochOperations.cs
new file mode 100644
index 0000000..94f3a96
--- /dev/null
+++ b/infrastructure/Hexalith.Platform.Custody.Dapr/AwsEpochOperations.cs
@@ -0,0 +1,58 @@
+using Amazon.KeyManagementService;
+using Amazon.KeyManagementService.Model;
+namespace Hexalith.Platform.Custody.Dapr;
+
+internal interface IEpochOperations
+{
+    Task<byte[]> EncryptOuterKeyAsync(string epoch, string tenant, byte[] key, CancellationToken token);
+    Task<byte[]> ReencryptOuterKeyAsync(string source, string destination, string tenant, byte[] encryptedKey, CancellationToken token);
+    Task ScheduleSourceCutAsync(string epoch, string tenant, CancellationToken token);
+}
+
+// Invoked only by an admitted durable worker, never lookup or ordinary host startup.
+// This type deliberately has no CreateKey, CancelKeyDeletion, ImportKeyMaterial, replica, or export capability.
+internal sealed class AwsEpochOperations(ComponentProfile profile, IAmazonKeyManagementService kms) : IEpochOperations
+{
+    private async Task<NativeEpoch> VerifyEpochAsync(string opaque, string tenant, CancellationToken token)
+    {
+        var epoch = profile.Epochs.SingleOrDefault(e => e.OpaqueId == opaque && e.TenantId == tenant)
+            ?? throw new AuthorityUnavailableException("Epoch is not independently enrolled.");
+        var response = await kms.DescribeKeyAsync(new DescribeKeyRequest { KeyId = epoch.KeyArn }, token);
+        var key = response.KeyMetadata;
+        if (key?.Arn != epoch.KeyArn || key.KeyId != epoch.KeyId || key.MultiRegion != false || key.Origin != OriginType.AWS_KMS
+            || key.KeySpec != KeySpec.SYMMETRIC_DEFAULT || key.KeyUsage != KeyUsageType.ENCRYPT_DECRYPT || key.KeyState != KeyState.Enabled
+            || !string.IsNullOrEmpty(key.CustomKeyStoreId))
+            throw new AuthorityUnavailableException("Epoch identity/origin/state is unsuitable.");
+        return epoch;
+    }
+    public async Task<byte[]> EncryptOuterKeyAsync(string epoch, string tenant, byte[] key, CancellationToken token)
+    {
+        if (key.Length != 32) throw new AuthorityUnavailableException("Exact outer key length required.");
+        var enrolled = await VerifyEpochAsync(epoch, tenant, token);
+        using var plain = new MemoryStream(key, writable: false);
+        var response = await kms.EncryptAsync(new EncryptRequest { KeyId = enrolled.KeyArn, Plaintext = plain,
+            EncryptionContext = Context(tenant, epoch), EncryptionAlgorithm = EncryptionAlgorithmSpec.SYMMETRIC_DEFAULT }, token);
+        if (response.KeyId != enrolled.KeyArn) throw new AuthorityUnavailableException("Unexpected native encryption key.");
+        return response.CiphertextBlob.ToArray();
+    }
+    public async Task<byte[]> ReencryptOuterKeyAsync(string source, string destination, string tenant, byte[] encryptedKey, CancellationToken token)
+    {
+        var from = await VerifyEpochAsync(source, tenant, token); var to = await VerifyEpochAsync(destination, tenant, token);
+        using var cipher = new MemoryStream(encryptedKey, writable: false);
+        var response = await kms.ReEncryptAsync(new ReEncryptRequest { SourceKeyId = from.KeyArn, DestinationKeyId = to.KeyArn,
+            CiphertextBlob = cipher, SourceEncryptionContext = Context(tenant, source), DestinationEncryptionContext = Context(tenant, destination) }, token);
+        if (response.SourceKeyId != from.KeyArn || response.KeyId != to.KeyArn) throw new AuthorityUnavailableException("Unexpected native survivor lineage.");
+        return response.CiphertextBlob.ToArray();
+    }
+    public async Task ScheduleSourceCutAsync(string epoch, string tenant, CancellationToken token)
+    {
+        var enrolled = await VerifyEpochAsync(epoch, tenant, token);
+        var response = await kms.ScheduleKeyDeletionAsync(new ScheduleKeyDeletionRequest { KeyId = enrolled.KeyArn, PendingWindowInDays = 7 }, token);
+        if (response.KeyId != enrolled.KeyArn || response.KeyState != KeyState.PendingDeletion)
+            throw new AuthorityUnavailableException("Native scheduling result uncertain.");
+        // Successful scheduling is not final erasure evidence and returns no terminal receipt.
+    }
+    private Dictionary<string, string> Context(string tenant, string epoch) => new() {
+        ["authority"] = profile.Enrollment.AuthorityId, ["incarnation"] = profile.Enrollment.AuthorityIncarnation,
+        ["tenant"] = tenant, ["epoch"] = epoch, ["purpose"] = "custody-outer-key-v1" };
+}
diff --git a/infrastructure/Hexalith.Platform.Custody.Dapr/AwsKeyAccess.cs b/infrastructure/Hexalith.Platform.Custody.Dapr/AwsKeyAccess.cs
new file mode 100644
index 0000000..5d7d599
--- /dev/null
+++ b/infrastructure/Hexalith.Platform.Custody.Dapr/AwsKeyAccess.cs
@@ -0,0 +1,44 @@
+using Amazon.KeyManagementService;
+using Amazon.KeyManagementService.Model;
+namespace Hexalith.Platform.Custody.Dapr;
+internal interface IKeyAccess
+{
+    Task<byte[]> ReadTenantKekAsync(string tenant, string version, CancellationToken token);
+    Task<byte[]> ReadOuterKeyAsync(StoredRegistration registration, CancellationToken token);
+}
+internal sealed class AwsKeyAccess(ComponentProfile profile, IAmazonKeyManagementService kms) : IKeyAccess
+{
+    public async Task<byte[]> ReadTenantKekAsync(string tenant, string version, CancellationToken token)
+    {
+        var kek = profile.Keks.SingleOrDefault(k => k.TenantId == tenant && k.Version == version)
+            ?? throw new AuthorityUnavailableException("Original KEK not enrolled.");
+        return await DecryptAsync(kek.ProtectorArn, kek.ProtectorKeyId, kek.EncryptedKey, new() {
+            ["authority"] = profile.Enrollment.AuthorityId, ["tenant"] = tenant, ["kekVersion"] = version,
+            ["purpose"] = "custody-tenant-kek-v1" }, token);
+    }
+    public async Task<byte[]> ReadOuterKeyAsync(StoredRegistration registration, CancellationToken token)
+    {
+        var epoch = profile.Epochs.SingleOrDefault(e => e.OpaqueId == registration.Epoch && e.TenantId == registration.Registration.Identity.TenantId)
+            ?? throw new AuthorityUnavailableException("Original epoch not enrolled.");
+        return await DecryptAsync(epoch.KeyArn, epoch.KeyId, registration.EncryptedOuterKey, new() {
+            ["authority"] = profile.Enrollment.AuthorityId, ["incarnation"] = profile.Enrollment.AuthorityIncarnation,
+            ["tenant"] = epoch.TenantId, ["epoch"] = epoch.OpaqueId, ["purpose"] = "custody-outer-key-v1" }, token);
+    }
+    private async Task<byte[]> DecryptAsync(string arn, string id, byte[] encrypted, Dictionary<string, string> context, CancellationToken token)
+    {
+        var response = await kms.DescribeKeyAsync(new DescribeKeyRequest { KeyId = arn }, token); var key = response.KeyMetadata;
+        if (key?.Arn != arn || key.KeyId != id || key.MultiRegion != false || key.Origin != OriginType.AWS_KMS
+            || key.KeySpec != KeySpec.SYMMETRIC_DEFAULT || key.KeyState != KeyState.Enabled || !string.IsNullOrEmpty(key.CustomKeyStoreId))
+            throw new AuthorityUnavailableException("Key identity/origin mismatch.");
+        using var ciphertext = new MemoryStream(encrypted, writable: false);
+        var decrypted = await kms.DecryptAsync(new DecryptRequest { KeyId = arn, CiphertextBlob = ciphertext,
+            EncryptionContext = context, EncryptionAlgorithm = EncryptionAlgorithmSpec.SYMMETRIC_DEFAULT }, token);
+        using var plaintext = decrypted.Plaintext;
+        try
+        {
+            if (decrypted.KeyId != arn || plaintext.Length != 32) throw new AuthorityUnavailableException("Invalid native key response.");
+            return plaintext.ToArray();
+        }
+        finally { if (plaintext.TryGetBuffer(out var buffer)) System.Security.Cryptography.CryptographicOperations.ZeroMemory(buffer.AsSpan()); }
+    }
+}
diff --git a/infrastructure/Hexalith.Platform.Custody.Dapr/BindingService.cs b/infrastructure/Hexalith.Platform.Custody.Dapr/BindingService.cs
new file mode 100644
index 0000000..82e6ff9
--- /dev/null
+++ b/infrastructure/Hexalith.Platform.Custody.Dapr/BindingService.cs
@@ -0,0 +1,67 @@
+using Dapr.Proto.Components.V1;
+using PingRequest = Dapr.Client.Autogen.Grpc.v1.PingRequest;
+using PingResponse = Dapr.Client.Autogen.Grpc.v1.PingResponse;
+using Google.Protobuf;
+using Grpc.Core;
+using Hexalith.Platform.Secrets.Runtime;
+namespace Hexalith.Platform.Custody.Dapr;
+
+internal sealed class BindingService(ComponentProfile profile, SemanticProvider provider, IAuthorityStore store) : OutputBinding.OutputBindingBase
+{
+    private int _initialized;
+    public override async Task<OutputBindingInitResponse> Init(OutputBindingInitRequest request, ServerCallContext context)
+    {
+        if (request.Metadata?.Properties is not { Count: 1 } values || !values.TryGetValue("profileDigest", out string? digest)
+            || digest != profile.ProfileDigest) throw Closed("Init profile mismatch.");
+        try { foreach (string tenant in profile.Tenants) _ = await store.ReadAsync(tenant, context.CancellationToken); }
+        catch { throw Closed("Surviving authority unavailable."); }
+        Interlocked.Exchange(ref _initialized, 1); // Same-profile re-Init does not clear any durable state.
+        return new();
+    }
+    public override Task<PingResponse> Ping(PingRequest request, ServerCallContext context) => Task.FromResult(new PingResponse());
+    public override Task<ListOperationsResponse> ListOperations(ListOperationsRequest request, ServerCallContext context)
+    {
+        var response = new ListOperationsResponse(); response.Operations.AddRange(CustodyBindingContract.Operations); return Task.FromResult(response);
+    }
+    public override async Task<InvokeResponse> Invoke(InvokeRequest request, ServerCallContext context)
+    {
+        if (Volatile.Read(ref _initialized) == 0 || !FrameAllowed(request)
+            || !request.Metadata.TryGetValue("custody-operation-proof", out string? operation)
+            || !request.Metadata.TryGetValue("custody-control-proof", out string? control)) throw Closed("Exact operation proofs and Init required.");
+        byte[] data = [];
+        byte[] responseBytes = [];
+        CustodyBindingRequestV1? decoded = null;
+        CustodyBindingResponseV1? result = null;
+        try
+        {
+            data = request.Data.ToByteArray();
+            decoded = CustodyBindingContract.Decode(data);
+            if (decoded?.Envelope.Operation != request.Operation) throw Closed("Operation frame mismatch.");
+            result = await provider.InvokeAsync(data, CustodyJson.Read<SignedStatement>(Convert.FromBase64String(operation)),
+                CustodyJson.Read<SignedStatement>(Convert.FromBase64String(control)), context.CancellationToken,
+                request.Metadata.TryGetValue("custody-key-admission", out string? keyAdmission)
+                    ? CustodyJson.Read<SignedStatement>(Convert.FromBase64String(keyAdmission)) : null);
+            responseBytes = CustodyJson.Bytes(result);
+            var response = new InvokeResponse { Data = ByteString.CopyFrom(responseBytes), ContentType = "application/json" };
+            if (response.CalculateSize() + 5 >= CustodyBindingContract.MaximumPageFrameBytes) throw Closed("Complete response frame exceeds bound.");
+            return response;
+        }
+        catch (RpcException) { throw; }
+        catch { throw Closed("Authority/effect unknown; recover the original without resending native intent."); }
+        finally
+        {
+            System.Security.Cryptography.CryptographicOperations.ZeroMemory(data);
+            System.Security.Cryptography.CryptographicOperations.ZeroMemory(responseBytes);
+            if (decoded?.WrapInput is { } input) System.Security.Cryptography.CryptographicOperations.ZeroMemory(input.RootKey);
+            if (result?.KeyDelivery is { } delivery) System.Security.Cryptography.CryptographicOperations.ZeroMemory(delivery.RootKey);
+            // Immutable protobuf ByteString and gRPC/native transport copies remain enrolled holders;
+            // managed array cleanup cannot establish their completion or physical qualification.
+        }
+    }
+    internal static bool FrameAllowed(InvokeRequest request) => request.CalculateSize() <= CustodyBindingContract.CandidateRequestMessageBytes
+        && request.Data.Length <= CustodyBindingContract.MaximumRequestBytes
+        && request.Metadata.Count <= CustodyBindingDaprInvoker.MaximumForwardedMetadataEntries
+        && request.Metadata.Sum(pair => System.Text.Encoding.UTF8.GetByteCount(pair.Key) + System.Text.Encoding.UTF8.GetByteCount(pair.Value))
+            <= CustodyBindingDaprInvoker.MaximumForwardedMetadataBytes;
+    private static RpcException Closed(string message) => new(new Status(StatusCode.FailedPrecondition, message));
+}
diff --git a/infrastructure/Hexalith.Platform.Custody.Dapr/ClosureInventory.cs b/infrastructure/Hexalith.Platform.Custody.Dapr/ClosureInventory.cs
new file mode 100644
index 0000000..89ae43a
--- /dev/null
+++ b/infrastructure/Hexalith.Platform.Custody.Dapr/ClosureInventory.cs
@@ -0,0 +1,92 @@
+using Hexalith.Platform.Secrets.Runtime;
+namespace Hexalith.Platform.Custody.Dapr;
+
+internal enum CopyClass { Source, Target, Snapshot, Cache, Workflow, Broker, Export, Partial, Backup, DatabaseLog,
+    ObjectVersion, KmsGeneration, SdkBuffer, SidecarBuffer, UdsBuffer, GrpcBuffer, TlsBuffer, ComponentBuffer, HostMemory, Diagnostics }
+internal enum ClosureDisposition { VerifiedZeroed, IndependentlyTerminated, GatedCiphertext, PermanentlyDeleted, CryptographicallyErased }
+internal sealed record CopyEntry(string CopyId, CopyClass Class, string OwnerId, string LocationId, string ProducerIncarnation,
+    string? ParentCopyId, string Epoch, string TargetReference, string OutcomeOriginalDigest, string ClosureEvidenceDigest,
+    ClosureDisposition Disposition);
+internal sealed record SealedQueue(string QueueId, string ProducerIncarnation, long LastAdmittedSequence, long LastCompletedSequence,
+    string SealEvidenceDigest, string TerminationEvidenceDigest);
+internal sealed record ClassCoverage(CopyClass Class, string InventoryEvidenceDigest, string[] CopyIds);
+internal sealed record ClosureInventory(string ManifestDigest, string SourceEpoch, string SuccessorEpoch, CopyEntry[] Copies,
+    SealedQueue[] Queues, ClassCoverage[] Coverage, string[] ProducerIncarnations, string[] NativeIntentIds);
+
+internal static class ClosureRules
+{
+    internal static async Task<bool> KnownHoldersAsync(IAuthorityStore store, ClosureInventory inventory, Checkpoint state, CancellationToken token)
+    {
+        foreach (var retained in state.NativeResults.Where(pair => pair.Key.EndsWith(":admission", StringComparison.Ordinal)))
+        {
+            var statement = CustodyJson.Read<SignedStatement>(await store.ReadImmutableAsync(retained.Value, token));
+            var admission = CustodyJson.Read<KeyAdmission>(CustodyJson.Bytes(statement.Payload));
+            foreach (var holder in admission.Holders)
+            {
+                CopyClass kind = holder.Role switch { "caller" => CopyClass.HostMemory, "sdk" => CopyClass.SdkBuffer,
+                    "sidecar" => CopyClass.SidecarBuffer, "uds" => CopyClass.UdsBuffer, "grpc" => CopyClass.GrpcBuffer,
+                    "tls" => CopyClass.TlsBuffer, _ => CopyClass.ComponentBuffer };
+                if (!inventory.Copies.Any(copy => copy.CopyId == holder.CopyId && copy.Class == kind && copy.OwnerId == holder.OwnerId
+                    && copy.ProducerIncarnation == holder.ProcessIncarnation && copy.TargetReference == admission.KeyUse.OriginalRootReference
+                    && copy.OutcomeOriginalDigest == holder.AdmissionOriginalDigest
+                    && copy.Disposition is ClosureDisposition.VerifiedZeroed or ClosureDisposition.IndependentlyTerminated)) return false;
+            }
+        }
+        return true;
+    }
+    internal static bool Complete(ClosureInventory inventory, Checkpoint state, bool final)
+    {
+        var cycle = state.Cycle;
+        if (cycle is null || inventory.ManifestDigest != cycle.Manifest.Manifest!.Original.Capability.ManifestDigest
+            || inventory.SourceEpoch != cycle.SourceEpoch || inventory.SuccessorEpoch != cycle.SuccessorEpoch
+            || inventory.Coverage.Length != Enum.GetValues<CopyClass>().Length
+            || inventory.Coverage.Select(c => c.Class).Distinct().Count() != inventory.Coverage.Length
+            || inventory.Copies.Select(c => c.CopyId).Distinct(StringComparer.Ordinal).Count() != inventory.Copies.Length
+            || inventory.ProducerIncarnations.Length == 0 || inventory.Queues.Length == 0
+            || !inventory.NativeIntentIds.Order(StringComparer.Ordinal).SequenceEqual(state.NativeIntents.Keys.Order(StringComparer.Ordinal))) return false;
+        if (state.Deliveries.Values.Any(d => d.Phase != CustodyBindingIntentPhase.Closed)
+            || state.NativeIntents.Values.Any(i => i.Phase != CustodyBindingIntentPhase.Closed)) return false;
+        if (state.NativeIntents.Values.Any(i => !CustodyBindingContract.Text(i.ProducerIncarnation)
+            || !inventory.ProducerIncarnations.Contains(i.ProducerIncarnation, StringComparer.Ordinal))) return false;
+        // An independently signed inventory cannot contradict material already known to this checkpoint.
+        foreach (var registration in state.Registrations.Values)
+        {
+            if (!state.Originals.TryGetValue(registration.Registration.OperationId, out var original) || original.Response is null
+                || !inventory.Copies.Any(c => c.Class == CopyClass.ObjectVersion && c.TargetReference == registration.Registration.OpaqueWrappedKeyReference
+                    && c.Epoch == registration.Epoch && c.OutcomeOriginalDigest == original.Response.Sha256
+                    && c.Disposition == (final && registration.Epoch == cycle.SourceEpoch ? ClosureDisposition.CryptographicallyErased : ClosureDisposition.GatedCiphertext))) return false;
+        }
+        foreach (string epoch in cycle.AlternateEpochs.Concat(cycle.TaintedEpochs).Append(cycle.SourceEpoch).Append(cycle.SuccessorEpoch!).Distinct())
+            if (!inventory.Copies.Any(c => c.Class == CopyClass.KmsGeneration && c.Epoch == epoch && c.TargetReference == epoch
+                && c.Disposition == (epoch == cycle.SuccessorEpoch || !final && epoch == cycle.SourceEpoch
+                    ? ClosureDisposition.GatedCiphertext : ClosureDisposition.PermanentlyDeleted))) return false;
+        var ids = inventory.Copies.Select(c => c.CopyId).ToHashSet(StringComparer.Ordinal);
+        foreach (var coverage in inventory.Coverage)
+            if (!CustodyBindingContract.Digest(coverage.InventoryEvidenceDigest)
+                || !coverage.CopyIds.Order(StringComparer.Ordinal).SequenceEqual(inventory.Copies.Where(c => c.Class == coverage.Class).Select(c => c.CopyId).Order(StringComparer.Ordinal))) return false;
+        foreach (var copy in inventory.Copies)
+        {
+            if (!Enum.IsDefined(copy.Class) || !Enum.IsDefined(copy.Disposition)
+                || !new[] { copy.CopyId, copy.OwnerId, copy.LocationId, copy.ProducerIncarnation, copy.Epoch, copy.TargetReference }.All(x => CustodyBindingContract.Text(x))
+                || !CustodyBindingContract.Digest(copy.OutcomeOriginalDigest) || !CustodyBindingContract.Digest(copy.ClosureEvidenceDigest)
+                || !inventory.ProducerIncarnations.Contains(copy.ProducerIncarnation, StringComparer.Ordinal)
+                || copy.ParentCopyId is { } parent && (!ids.Contains(parent) || parent == copy.CopyId)) return false;
+            var visited = new HashSet<string>(StringComparer.Ordinal) { copy.CopyId }; var ancestor = copy.ParentCopyId;
+            while (ancestor is not null)
+            {
+                if (!visited.Add(ancestor)) return false;
+                ancestor = inventory.Copies.Single(c => c.CopyId == ancestor).ParentCopyId;
+            }
+            bool memory = copy.Class is CopyClass.SdkBuffer or CopyClass.SidecarBuffer or CopyClass.UdsBuffer or CopyClass.GrpcBuffer
+                or CopyClass.TlsBuffer or CopyClass.ComponentBuffer or CopyClass.HostMemory or CopyClass.Diagnostics;
+            if (memory && copy.Disposition is not (ClosureDisposition.VerifiedZeroed or ClosureDisposition.IndependentlyTerminated)) return false;
+            if (copy.Disposition == ClosureDisposition.CryptographicallyErased && (!final || copy.Epoch != cycle.SourceEpoch)) return false;
+            if (final && copy.Epoch == cycle.SourceEpoch && copy.Disposition == ClosureDisposition.GatedCiphertext) return false;
+            if (cycle.AlternateEpochs.Contains(copy.Epoch) || cycle.TaintedEpochs.Contains(copy.Epoch))
+                if (copy.Disposition is not (ClosureDisposition.PermanentlyDeleted or ClosureDisposition.VerifiedZeroed or ClosureDisposition.IndependentlyTerminated)) return false;
+        }
+        return inventory.ProducerIncarnations.All(p => inventory.Queues.Any(q => q.ProducerIncarnation == p))
+            && inventory.Queues.All(q => q.LastAdmittedSequence >= 0 && q.LastCompletedSequence == q.LastAdmittedSequence
+                && CustodyBindingContract.Digest(q.SealEvidenceDigest) && CustodyBindingContract.Digest(q.TerminationEvidenceDigest));
+    }
+}
diff --git a/infrastructure/Hexalith.Platform.Custody.Dapr/ComponentProfile.cs b/infrastructure/Hexalith.Platform.Custody.Dapr/ComponentProfile.cs
new file mode 100644
index 0000000..298894f
--- /dev/null
+++ b/infrastructure/Hexalith.Platform.Custody.Dapr/ComponentProfile.cs
@@ -0,0 +1,75 @@
+using System.Text.Json;
+using Hexalith.Platform.Secrets.Runtime;
+namespace Hexalith.Platform.Custody.Dapr;
+
+internal sealed record TrustedSigner(string KeyId, string Purpose, string PublicKeyPem);
+internal sealed record BucketIdentity(string Name, string OwnerAccountId, string EnrollmentKey, string EnrollmentVersion,
+    string EnrollmentSha256);
+internal sealed record NativeEpoch(string OpaqueId, string KeyArn, string KeyId, string TenantId);
+internal sealed record TenantKek(string TenantId, string Version, string ProtectorArn, string ProtectorKeyId, byte[] EncryptedKey);
+internal sealed record ComponentProfile(AuthorityEnrollmentV1 Enrollment, string Region, string TableArn, string TableId,
+    BucketIdentity Checkpoints, BucketIdentity Originals, DateTimeOffset RetainUntil, long CompletionReserveBytes,
+    string SocketPath, string ComponentSigningKeyPath, string ComponentPublicKeyPem, TrustedSigner[] Trust,
+    NativeEpoch[] Epochs, string[] Tenants, string QualificationStatementPath, TenantKek[] Keks)
+{
+    internal string EnrollmentDigest => CustodyJson.Hash(CustodyJson.Bytes(Enrollment));
+    // This includes private resource pins and trust, so a restored config cannot silently change them through Init.
+    internal string ProfileDigest => CustodyJson.Hash(CustodyJson.Bytes(this));
+    internal void Validate()
+    {
+        if (!CustodyBindingContract.ValidEnrollment(Enrollment) || string.IsNullOrWhiteSpace(Region)
+            || !TableArn.StartsWith("arn:aws:dynamodb:", StringComparison.Ordinal) || string.IsNullOrWhiteSpace(TableId)
+            || Tenants.Length != 2 || Tenants.Distinct(StringComparer.Ordinal).Count() != 2
+            || Epochs.Length > 5 || Epochs.Select(e => e.OpaqueId).Distinct(StringComparer.Ordinal).Count() != Epochs.Length
+            || Epochs.Any(e => !Tenants.Contains(e.TenantId) || !e.KeyArn.StartsWith("arn:aws:kms:", StringComparison.Ordinal))
+            || Keks.Length != 2 || Keks.Select(k => k.ProtectorArn).Distinct().Count() != 2
+            || Keks.Any(k => !Tenants.Contains(k.TenantId) || k.EncryptedKey.Length == 0)
+            || Checkpoints.Name == Originals.Name || Checkpoints.OwnerAccountId.Length != 12 || Originals.OwnerAccountId.Length != 12
+            || !CustodyBindingContract.Digest(Checkpoints.EnrollmentSha256) || !CustodyBindingContract.Digest(Originals.EnrollmentSha256)
+            || CompletionReserveBytes <= 0 || CompletionReserveBytes >= 32 * 1024 * 1024 || !Path.IsPathFullyQualified(SocketPath)
+            || Trust.Length < 3 || Trust.Select(t => t.KeyId).Distinct(StringComparer.Ordinal).Count() != Trust.Length)
+        { throw new AuthorityUnavailableException("Incomplete pre-enrolled component profile; startup cannot enroll resources."); }
+        if (Tenants.Any(tenant => Epochs.Count(e => e.TenantId == tenant) < 2 || Keks.Count(k => k.TenantId == tenant) != 1))
+            throw new AuthorityUnavailableException("Each tenant requires independent source/successor epochs and exactly one KEK mapping.");
+        var nativeKeys = Epochs.Select(e => (Arn: e.KeyArn, Id: e.KeyId)).Concat(Keks.Select(k => (Arn: k.ProtectorArn, Id: k.ProtectorKeyId))).ToArray();
+        if (nativeKeys.Any(k => string.IsNullOrWhiteSpace(k.Id) || !k.Arn.StartsWith("arn:aws:kms:", StringComparison.Ordinal))
+            || nativeKeys.Select(k => k.Arn).Distinct(StringComparer.Ordinal).Count() != nativeKeys.Length
+            || nativeKeys.Select(k => k.Id).Distinct(StringComparer.Ordinal).Count() != nativeKeys.Length)
+            throw new AuthorityUnavailableException("Native epoch and KEK identities must be disjoint across every lane.");
+        foreach (string purpose in new[] { "private-operation", "control", "independent-observer" })
+            if (Trust.Count(t => t.Purpose == purpose) != 1) throw new AuthorityUnavailableException("Independent trust role missing.");
+        string Fingerprint(string pem)
+        {
+            using var key = System.Security.Cryptography.ECDsa.Create(); key.ImportFromPem(pem);
+            if (key.ExportParameters(false).Curve.Oid.Value != "1.2.840.10045.3.1.7") throw new AuthorityUnavailableException("P-256 public trust required.");
+            return CustodyJson.Hash(key.ExportSubjectPublicKeyInfo());
+        }
+        if (Trust.Select(t => Fingerprint(t.PublicKeyPem)).Append(Fingerprint(ComponentPublicKeyPem)).Distinct(StringComparer.Ordinal).Count() != Trust.Length + 1)
+            throw new AuthorityUnavailableException("Signing roles must be independent.");
+    }
+    internal static ComponentProfile Load(string path) => CustodyJson.Read<ComponentProfile>(File.ReadAllBytes(path));
+}
+
+// The payload is a closed typed claim per purpose, never a caller 'verified=true' field.
+internal sealed record SignedStatement(string Purpose, string SignerId, string AuthorityId, string AuthorityIncarnation,
+    string TenantId, long Revision, string CheckpointDigest, string SubjectSha256, DateTimeOffset IssuedAt,
+    DateTimeOffset ExpiresAt, JsonElement Payload, byte[] Signature);
+internal sealed record OperationPermission(string Operation, string OperationId, string RequestAttemptId, string Challenge,
+    string OwnerPurposeScope, string ProfileDigest);
+internal sealed record QualificationClaim(string ProfileDigest, string ArtifactDigest, string TransportProfileDigest,
+    string ClosureProfileDigest, string CapacityMeasurementDigest, long CompletionReserveBytes,
+    string IndependentPlacementEvidenceDigest, string NativeAuthorizationDigest);
+internal sealed record ControlClaim(string ControlProofSha256, string GuardOriginalSha256, string ProtectionOriginalSha256,
+    string CurrentRevocationSha256, long CurrentGuardRevision, long? EffectiveDispatchRevision, string? EffectiveDispatchReceiptId,
+    HoldReservation? HoldReservation = null);
+// The control owner durably excludes dispatch until this exact reservation is reconciled. It cannot
+// expire on a timer or be canceled from a local app restore. Its signed current claim is not a read-then-write check.
+internal sealed record HoldReservation(string ReservationId, string HoldId, string TargetDigest, long RegisteredGuardRevision,
+    string RegisteredGuardReceiptId, string State);
+internal sealed record PreparationClaim(string ManifestDigest, string SourceEpoch, string SuccessorEpoch,
+    string InventoryDigest, string SurvivorCheckpointDigest, string ProducerClosureDigest, string HolderClosureDigest,
+    string[] PermanentlyDeletedAlternateEpochs, string[] SurvivorOpaqueReferences, string[] TargetOpaqueReferences,
+    string NativeIntegrityEvidenceDigest, string RestoreEvidenceDigest);
+internal sealed record FinalClaim(string ManifestDigest, string SourceEpoch, string SuccessorEpoch, string PreparationDigest,
+    string[] PermanentlyDeletedEpochs, string InventoryDigest, string HolderClosureDigest, string SurvivorRecoveryDigest,
+    string RestoreBarrierReceiptId, string NativeFinalEvidenceDigest, string OriginalSha256);
