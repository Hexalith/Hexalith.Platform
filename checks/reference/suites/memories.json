{
  "schema": "hexalith.check-suite.v1",
  "suiteId": "memories-reference",
  "version": "1.0.0",
  "module": "memories",
  "owner": "@jpiquot",
  "source": "src/Hexalith.Platform.Composition/Declarations/memories.json",
  "runtime": "python3",
  "entrypoint": "runner.py",
  "payload": [
    "memories.py",
    "runner.py"
  ],
  "checks": [
    {
      "id": "memories.ingest-search",
      "surface": "memories-api",
      "kind": "e2e",
      "assertion": "positive",
      "environments": [
        "staging"
      ],
      "timeoutSeconds": 120,
      "effect": "synthetic-write",
      "tenancy": "run-scoped-synthetic"
    },
    {
      "id": "memories.search",
      "surface": "memories-api",
      "kind": "smoke",
      "assertion": "positive",
      "environments": [
        "staging",
        "production"
      ],
      "timeoutSeconds": 30,
      "cadenceSeconds": 300,
      "effect": "read",
      "tenancy": "existing-synthetic"
    }
  ]
}
