<Project>
  <PropertyGroup><ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally><CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled></PropertyGroup>
  <Import Project="$(HexalithEventStoreRoot)/Directory.Packages.props" Condition="'$(UseHexalithProjectReferences)' == 'true'" />
  <Import Project="../Hexalith.Builds/Props/Directory.Packages.props" Condition="'$(UseHexalithProjectReferences)' != 'true' and Exists('../Hexalith.Builds/Props/Directory.Packages.props')" />
  <Import Project="references/Hexalith.Builds/Props/Directory.Packages.props" Condition="'$(UseHexalithProjectReferences)' != 'true' and '$(HexalithVersionsLoaded)' != 'true'" />
</Project>
