# Source: dapr/charts/dapr_placement/templates/dapr_placement_service.yaml
kind: Service
apiVersion: v1
metadata:
  name: dapr-placement-server
  namespace: dapr-system
  labels:
    app: dapr-placement-server
    app.kubernetes.io/component: placement
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: dapr
    app.kubernetes.io/part-of: dapr
    app.kubernetes.io/version: 1.19.2
  annotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "9090"
    prometheus.io/path: "/"
spec:
  selector:
    app: dapr-placement-server
  # placement must be able to resolve pod address to join initial cluster peers
  # before POD is ready
  publishNotReadyAddresses: true
  ports:
  - name: api
    port: 50005
    # gRPC wrapped in Dapr control plane mTLS: declare tls, not grpc, so
    # service meshes do not parse the traffic as plaintext h2c.
    appProtocol: tls
  - name: raft-node
    port: 8201
    # raft RPC wrapped in Dapr control plane mTLS.
    appProtocol: tls
  - name: metrics
    port: 9090
    targetPort: 9090
    protocol: TCP
    appProtocol: http
  clusterIP: None

---
# Source: dapr/charts/dapr_scheduler/templates/dapr_scheduler_service.yaml
kind: Service
apiVersion: v1
metadata:
  name: dapr-scheduler-server-a
  namespace: dapr-system
  labels:
    app: dapr-scheduler-server
    app.kubernetes.io/component: scheduler
    app.kubernetes.io/managed-by: Helm
    app.kubernetes.io/name: dapr
    app.kubernetes.io/part-of: dapr
    app.kubernetes.io/version: 1.19.2
  annotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "9090"
    prometheus.io/path: "/"
spec:
  selector:
    app: dapr-scheduler-server
  # scheduler must be able to resolve pod address to join initial cluster peers
  # before POD is ready
  publishNotReadyAddresses: true
  ports:
  - name: api
    port: 443
    targetPort: 50006
    # gRPC wrapped in Dapr control plane mTLS: declare tls, not grpc, so
    # service meshes do not parse the traffic as plaintext h2c.
    appProtocol: tls
  - name: etcd-client
    port: 2379
    # etcd only listens for client connections on localhost, without TLS.
    appProtocol: tcp
  - name: etcd-peer
    port: 2380
    appProtocol: tls
  - name: metrics
    port: 9090
    targetPort: 9090
    protocol: TCP
    appProtocol: http
  type: ClusterIP
