apiVersion: dapr.io/v1alpha1
kind: Configuration
metadata:
  name: platform-eventstore
spec:
  mtls:
    enabled: true
    controlPlaneTrustDomain: "cluster.local"
    sentryAddress: "dapr-sentry.dapr-system.svc.cluster.local:443"
  features:
    - name: HotReload
      enabled: false
  accessControl:
    defaultAction: deny
    policies:
    - appId: memories
      defaultAction: deny
      namespace: reference
      operations:
      - action: allow
        httpVerb:
        - POST
        name: /api/v1/commands/bound/workload
      trustDomain: fixture.invalid
    - appId: tenants
      defaultAction: deny
      namespace: reference
      operations:
      - action: allow
        httpVerb:
        - POST
        name: /api/v1/commands/bound/workload
      - action: allow
        httpVerb:
        - POST
        name: /api/v1/streams/read/workload
      trustDomain: fixture.invalid
    - appId: tenants-api
      defaultAction: deny
      namespace: reference
      operations:
      - action: allow
        httpVerb:
        - POST
        name: /api/v1/commands
      - action: allow
        httpVerb:
        - POST
        name: /api/v1/queries
      trustDomain: fixture.invalid
    - appId: timesheets
      defaultAction: deny
      namespace: reference
      operations:
      - action: allow
        httpVerb:
        - GET
        name: /api/v1/commands/status/workload
      - action: allow
        httpVerb:
        - POST
        name: /api/v1/commands/workload
      - action: allow
        httpVerb:
        - GET
        name: /api/v1/commands/status/*
      - action: allow
        httpVerb:
        - POST
        name: /api/v1/commands/*
      - action: allow
        httpVerb:
        - POST
        name: /api/v1/queries
      trustDomain: fixture.invalid
    trustDomain: fixture.invalid
