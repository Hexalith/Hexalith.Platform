  template:
    metadata:
      labels:
        app.kubernetes.io/name: eventstore
      annotations:
        dapr.io/enabled: "true"
        dapr.io/app-id: "eventstore"
        dapr.io/app-port: "8080"
        dapr.io/app-protocol: http
        dapr.io/config: "platform-eventstore"
        dapr.io/app-token-secret: "fixture-eventstore-app"
        dapr.io/api-token-secret: "fixture-eventstore-api"
        dapr.io/sidecar-listen-addresses: "127.0.0.1"
        dapr.io/enable-api-logging: "false"
    spec:
      automountServiceAccountToken: true
      imagePullSecrets:
        - name: fixture-registry
      securityContext:
        runAsNonRoot: true
        runAsUser: 1654
