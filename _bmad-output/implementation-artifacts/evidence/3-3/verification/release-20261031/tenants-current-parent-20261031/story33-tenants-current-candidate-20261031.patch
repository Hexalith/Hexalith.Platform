diff --git a/src/Hexalith.Tenants/Bootstrap/TenantBootstrapBoundCommand.cs b/src/Hexalith.Tenants/Bootstrap/TenantBootstrapBoundCommand.cs
new file mode 100644
index 00000000..3b8ad986
--- /dev/null
+++ b/src/Hexalith.Tenants/Bootstrap/TenantBootstrapBoundCommand.cs
@@ -0,0 +1,72 @@
+using System.Net.Http.Json;
+using System.Security.Claims;
+using System.Text.Json;
+
+using Dapr.Client;
+
+using Hexalith.EventStore.Authorization;
+using Hexalith.EventStore.Client.Gateway;
+using Hexalith.EventStore.Contracts.Commands;
+using Hexalith.EventStore.ServiceDefaults.Authentication;
+using Hexalith.EventStore.ServiceDefaults.Routing;
+using Hexalith.Tenants.Contracts.Commands;
+using Hexalith.Tenants.Contracts.Identity;
+
+using Microsoft.AspNetCore.Authentication;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.Extensions.Configuration;
+
+namespace Hexalith.Tenants.Bootstrap;
+
+/// <summary>Preserves a cryptographically authenticated administrator through the existing exact bound workload command protocol.</summary>
+internal static class TenantBootstrapBoundCommand
+{
+    internal static async Task<HttpRequestMessage?> CreateAsync(IServiceProvider services, IConfiguration configuration,
+        DaprClient dapr, SubmitCommandRequest command, string administrator, string accessToken, TimeProvider clock,
+        TimeSpan readinessTimeout, CancellationToken token)
+    {
+        token.ThrowIfCancellationRequested();
+        if (readinessTimeout <= TimeSpan.Zero) throw new ArgumentOutOfRangeException(nameof(readinessTimeout));
+        var context = new DefaultHttpContext { RequestServices = services, RequestAborted = token };
+        context.Request.Headers.Authorization = "Bearer " + accessToken;
+        // Use the owning host's real installed bearer handler, including OIDC signing-key
+        // discovery, issuer, audience, signature and lifetime validation. Decoding sub is not authority.
+        var authenticated = await services.GetRequiredService<IAuthenticationService>()
+            .AuthenticateAsync(context, JwtBearerDefaults.AuthenticationScheme).ConfigureAwait(false);
+        if (!authenticated.Succeeded || authenticated.Principal is not { } principal) return null;
+        var human = new ClaimsPrincipal(principal.Identities.Where(identity => identity.IsAuthenticated));
+        Claim[] subjects = human.FindAll("sub").ToArray();
+        if (subjects.Length != 1 || subjects[0].Value != administrator || !GlobalAdministratorHelper.IsGlobalAdministrator(human)
+            || human.HasClaim(claim => claim.Type == EventStoreWorkloadAuthenticationDefaults.WorkloadClaimType)
+            || command.Tenant != TenantIdentity.DefaultTenantId || command.Domain != TenantIdentity.GlobalAdministratorsDomain
+            || command.AggregateId != TenantIdentity.GlobalAdministratorsAggregateId || command.CommandType != nameof(BootstrapGlobalAdmin)
+            || command.Payload.Deserialize<BootstrapGlobalAdmin>(JsonSerializerOptions.Web)?.UserId != subjects[0].Value) return null;
+        string? caller = configuration["Authentication:WorkloadIssuer:Workload"];
+        string? privateKey = configuration["Authentication:BoundStreamRead:PrivateKey"];
+        if (string.IsNullOrWhiteSpace(caller) || string.IsNullOrWhiteSpace(privateKey)) return null;
+        if (services.GetService<IRouteCatalogAuthority>() is { } authority
+            && configuration["EventStore:RouteCatalog:DevelopmentBootstrap:RootDigest"] is { Length: > 0 } root)
+        {
+            using var deadline = CancellationTokenSource.CreateLinkedTokenSource(token); deadline.CancelAfter(readinessTimeout);
+            while (true)
+            {
+                try
+                {
+                    var readback = await authority.ReadbackAsync(deadline.Token).ConfigureAwait(false);
+                    if (readback.Serving && readback.RootDigest == root) break;
+                }
+                catch (RouteCatalogUnavailableException) { }
+                await Task.Delay(100, deadline.Token).ConfigureAwait(false);
+            }
+        }
+        string? assertion = await services.GetRequiredService<IWorkloadAssertionIssuer>()
+            .IssueAsync(new("eventstore", EventStoreWorkloadOperations.GatewayCommandSubmit), token).ConfigureAwait(false);
+        if (string.IsNullOrWhiteSpace(assertion)) return null;
+        var bound = new BoundWorkloadCommandRequest(command, subjects[0].Value);
+        var request = dapr.CreateInvokeMethodRequest(HttpMethod.Post, "eventstore", "api/v1/commands/bound/workload");
+        request.Content = JsonContent.Create(bound);
+        request.Headers.Add(EventStoreWorkloadAuthenticationDefaults.AssertionHeaderName, assertion);
+        request.Headers.Add(BoundWorkloadCommandProof.HeaderName, BoundWorkloadCommandProof.Issue(bound, caller, privateKey, clock.GetUtcNow()));
+        return request;
+    }
+}
diff --git a/src/Hexalith.Tenants/Bootstrap/TenantBootstrapReceipt.cs b/src/Hexalith.Tenants/Bootstrap/TenantBootstrapReceipt.cs
new file mode 100644
index 00000000..4e1de4c6
--- /dev/null
+++ b/src/Hexalith.Tenants/Bootstrap/TenantBootstrapReceipt.cs
@@ -0,0 +1,66 @@
+using System.Text.Json;
+
+using Microsoft.Extensions.Configuration;
+
+namespace Hexalith.Tenants.Bootstrap;
+
+/// <summary>Private delivery evidence for the existing bootstrap workflow; projected membership remains the authority.</summary>
+internal sealed record TenantBootstrapReceipt(string AttemptId, string RootDigest, string MessageId,
+    string CorrelationId, string PrincipalId, string Phase, int? HttpStatus)
+{
+    internal static async Task<TenantBootstrapReceipt?> BeginAsync(IConfiguration configuration, string messageId,
+        string correlationId, string principalId, CancellationToken token)
+    {
+        string? path = ReceiptPath(configuration);
+        if (path is null) return null;
+        var receipt = new TenantBootstrapReceipt(configuration["EventStore:RouteCatalog:DevelopmentBootstrap:AttemptId"]!,
+            configuration["EventStore:RouteCatalog:DevelopmentBootstrap:RootDigest"]!, messageId, correlationId, principalId, "attempted", null);
+        if (string.IsNullOrWhiteSpace(receipt.AttemptId) || string.IsNullOrWhiteSpace(receipt.RootDigest))
+            throw new InvalidOperationException("The bootstrap receipt requires the actual private catalog attempt.");
+        await WriteNewAsync(path, JsonSerializer.SerializeToUtf8Bytes(receipt), token).ConfigureAwait(false);
+        return receipt;
+    }
+
+    internal async Task CompleteAsync(IConfiguration configuration, int status, string phase, CancellationToken token)
+    {
+        string path = ReceiptPath(configuration) ?? throw new InvalidOperationException("The bootstrap receipt path changed.");
+        RequirePrivate(path);
+        byte[] original = JsonSerializer.SerializeToUtf8Bytes(this);
+        if (new FileInfo(path).Length != original.Length || !(await File.ReadAllBytesAsync(path, token).ConfigureAwait(false)).AsSpan().SequenceEqual(original))
+            throw new InvalidOperationException("The bootstrap delivery receipt changed; preserve it for recovery.");
+        string pending = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        await WriteNewAsync(pending, JsonSerializer.SerializeToUtf8Bytes(this with { Phase = phase, HttpStatus = status }), token).ConfigureAwait(false);
+        RequirePrivate(path);
+        File.Move(pending, path, overwrite: true);
+    }
+
+    private static string? ReceiptPath(IConfiguration configuration)
+    {
+        if (configuration["Tenants:BootstrapBoundWorkloadReceiptPath"] is not { Length: > 0 } path) return null;
+        string directory = configuration["EventStore:RouteCatalog:DevelopmentBootstrap:Directory"]
+            ?? throw new InvalidOperationException("The bootstrap receipt has no actual private catalog directory.");
+        if (!Path.IsPathFullyQualified(directory) || !Path.IsPathFullyQualified(path)
+            || Path.GetFullPath(path) != Path.Combine(Path.GetFullPath(directory), "tenants.bootstrap.json"))
+            throw new InvalidOperationException("The bootstrap receipt must remain in its actual private catalog directory.");
+        RequirePrivate(directory, directory: true);
+        return path;
+    }
+
+    private static void RequirePrivate(string path, bool directory = false)
+    {
+        FileSystemInfo entry = directory ? new DirectoryInfo(path) : new FileInfo(path);
+        if (!entry.Exists || entry.LinkTarget is not null || (entry.Attributes & FileAttributes.ReparsePoint) != 0
+            || !OperatingSystem.IsWindows() && (File.GetUnixFileMode(path) & (UnixFileMode.GroupRead | UnixFileMode.GroupWrite | UnixFileMode.GroupExecute
+                | UnixFileMode.OtherRead | UnixFileMode.OtherWrite | UnixFileMode.OtherExecute)) != 0)
+            throw new InvalidOperationException("The bootstrap receipt requires an owned regular private entry.");
+    }
+
+    private static async Task WriteNewAsync(string path, byte[] bytes, CancellationToken token)
+    {
+        var options = new FileStreamOptions { Mode = FileMode.CreateNew, Access = FileAccess.Write, Share = FileShare.Read };
+        if (!OperatingSystem.IsWindows()) options.UnixCreateMode = UnixFileMode.UserRead | UnixFileMode.UserWrite;
+        var stream = new FileStream(path, options);
+        await using (stream.ConfigureAwait(false))
+            await stream.WriteAsync(bytes, token).ConfigureAwait(false);
+    }
+}
