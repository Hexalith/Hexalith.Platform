diff --git a/src/libraries/Hexalith.Builds.Tooling/Runtime/SelectedMetadataSafety.cs b/src/libraries/Hexalith.Builds.Tooling/Runtime/SelectedMetadataSafety.cs
new file mode 100644
index 0000000..acc3fe5
