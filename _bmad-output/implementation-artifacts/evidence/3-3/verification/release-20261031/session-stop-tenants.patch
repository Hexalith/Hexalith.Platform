diff --git a/src/Hexalith.Tenants.AppHost/TenantsDevelopmentRoutingCatalog.cs b/src/Hexalith.Tenants.AppHost/TenantsDevelopmentRoutingCatalog.cs
new file mode 100644
index 00000000..38ed2457
--- /dev/null
+++ b/src/Hexalith.Tenants.AppHost/TenantsDevelopmentRoutingCatalog.cs
@@ -0,0 +1,27 @@
+using Aspire.Hosting;
+using Aspire.Hosting.ApplicationModel;
+using Hexalith.EventStore.Aspire;
+using Hexalith.EventStore.DomainService;
+using Hexalith.Tenants.Contracts.Routing;
+using Hexalith.Tenants.Server.Routing;
+
+namespace Hexalith.Tenants.AppHost;
+
+/// <summary>Declares the existing owner traffic for the shared SDK's private Development catalog composition.</summary>
+internal static class TenantsDevelopmentRoutingCatalog
+{
+    internal static DevelopmentRouteCatalogComposition Create(IDistributedApplicationBuilder builder,
+        IResourceBuilder<ProjectResource> gateway, IResourceBuilder<ProjectResource> domain,
+        IResourceBuilder<ProjectResource> api, IResourceBuilder<ProjectResource> ui, string stateComponent)
+    {
+        // The former gateway /** POST grant already covered these exact SDK operational routes.
+        // Human bootstrap and API POSTs retain their own existing credentials and authorization.
+        DevelopmentRouteCatalogInvocation[] domainCalls = EventStoreDomainServiceRoutes.Operational
+            .Select(route => new DevelopmentRouteCatalogInvocation(gateway, route.Route, ["POST"])).ToArray();
+        return builder.AddEventStoreDevelopmentRouteCatalog(gateway,
+            [new(domain, typeof(TenantCatalogDeclarations).Assembly, typeof(TenantIntentAdapters).Assembly)],
+            [new(gateway, [new(domain, "/api/v1/commands", ["POST"]), new(domain, "/api/v1/streams/read/workload", ["POST"]),
+                new(api, "/api/v1/commands", ["POST"]), new(api, "/api/v1/queries", ["POST"]), new(api, "/ready", ["GET"])]),
+                new(domain, domainCalls), api.CaptureEventStoreDevelopmentReceiver(ui)], stateComponent);
+    }
+}
