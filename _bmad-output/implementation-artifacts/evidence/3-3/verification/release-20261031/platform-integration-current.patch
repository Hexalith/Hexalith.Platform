+    [Fact]
+    public async Task CatalogBootstrapBindsActualKeysPoliciesFilesAndCohortStartWaitsAsync()
+    {
+        string workspace = Path.Combine(Path.GetTempPath(), "catalog-bootstrap-contract-" + Guid.NewGuid().ToString("N"));
