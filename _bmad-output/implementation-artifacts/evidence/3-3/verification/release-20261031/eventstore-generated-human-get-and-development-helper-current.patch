+using System.Text.Json;
+using Hexalith.EventStore.Contracts.Commands;
+using Hexalith.EventStore.Contracts.Projections;
+using Hexalith.EventStore.Contracts.Routing;
+using Hexalith.EventStore.DomainService;
+using Hexalith.EventStore.Sample.Counter.Commands;
+using Hexalith.EventStore.Sample.Counter.Queries;
+
+[assembly: RouteCatalogAdapterSource(typeof(Hexalith.EventStore.Sample.Counter.SampleCatalog))]
+
+namespace Hexalith.EventStore.Sample.Counter;
+
+/// <summary>Explicit Sample owner schemas and conservative human UI policy for its existing seven operations.</summary>
+public static partial class SampleCatalog
+{
+    /// <summary>The six existing public commands/query are UI-only. Projection remains internal and requires its existing verified service channel.</summary>
+    public static IReadOnlyList<RouteOperationContract> Operations => Routes.Select(route =>
+    {
+        Type request = route.Kind == "projection" ? typeof(ProjectionRequest) : new[] { typeof(SampleCatalog).Assembly, typeof(IncrementCounter).Assembly }
+            .Select(assembly => assembly.GetType(route.Execution!.HandlerType)).Single(type => type is not null)!;
+        Type result = route.Kind switch { "command" => typeof(SubmitCommandResponse), "query" => typeof(CounterStatusProjection), _ => typeof(ProjectionResponse) };
+        return RouteOperationSchema.Create(route, request, result, route.Kind == "projection" ? "internal" : "public", "UI-only", new JsonSerializerOptions(JsonSerializerDefaults.Web));
+    }).ToArray();
+
+    /// <summary>The existing domain methods and SDK ProjectionActor query method, without changing route or actor semantics.</summary>
+    public static IReadOnlyDictionary<string, string> ReceiverMethods => Routes.ToDictionary(route => route.RouteId,
+        route => route.Kind switch { "command" => "process", "query" => RouteCatalogProjectionActorPolicy.Method, _ => "project" }, StringComparer.Ordinal);
+
+    /// <summary>The existing five target-only MessageId-v1/Mutation adapters, exposed through the normal compiled factory contract.</summary>
+    public static IReadOnlyList<IDeclaredIdempotencyIntentAdapter> Create() => CreateAdapters();
+}
