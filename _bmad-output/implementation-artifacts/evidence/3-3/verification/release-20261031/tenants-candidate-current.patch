diff --git a/scripts/verify-api-release-artifact.sh b/scripts/verify-api-release-artifact.sh
new file mode 100755
index 00000000..bc48797f
--- /dev/null
+++ b/scripts/verify-api-release-artifact.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+# Verify the API image from the normal release without changing historical server recovery.
+set -euo pipefail
+
+repository="${GITHUB_REPOSITORY:-Hexalith/Hexalith.Tenants}"
+source_sha="${GITHUB_SHA:-}"
+source "$(dirname "${BASH_SOURCE[0]}")/partial-release-recovery-common.sh"
+shopt -s nullglob
+for prior in .hexalith/release-evidence/*/tenants-api-destination; do
+  prior="$(recovery_confine_directory "$prior")"
+  rm -f "$prior/verified.json"
+done
+shopt -u nullglob
+[[ "$source_sha" =~ ^[0-9a-f]{40}$ ]] || recovery_fail 'Source SHA must be an exact lowercase commit SHA.'
+[ "$repository" = 'Hexalith/Hexalith.Tenants' ] || recovery_fail 'The API image must belong to Hexalith.Tenants.'
+
+receipt="${HEXALITH_RELEASE_API_OCI_RECEIPT:-}"
+if [ -z "$receipt" ]; then
+  shopt -s nullglob
+  receipts=(.hexalith/release-evidence/*/tenants-api/oci-validation.json)
+  shopt -u nullglob
+  [ "${#receipts[@]}" -eq 1 ] || recovery_fail 'Exactly one API publisher OCI receipt is required.'
+  receipt="${receipts[0]}"
+fi
+recovery_confine_directory "$(dirname "$receipt")" >/dev/null
+[ -f "$receipt" ] || recovery_fail 'The API publisher OCI receipt is missing.'
+shopt -s nullglob
+release_proofs=(.hexalith/release-evidence/*/destinations/verified.json)
+shopt -u nullglob
+if [ -n "${HEXALITH_RELEASE_DESTINATION_EVIDENCE_DIRECTORY:-}" ]; then
+  release_proofs=("$HEXALITH_RELEASE_DESTINATION_EVIDENCE_DIRECTORY/verified.json")
+fi
+[ "${#release_proofs[@]}" -eq 1 ] || recovery_fail 'Exactly one verified normal release result is required.'
+release_proof="${release_proofs[0]}"
+recovery_confine_directory "$(dirname "$release_proof")" >/dev/null
+[ -f "$release_proof" ] || recovery_fail 'The verified normal release result is missing.'
+version="$(jq -er '.version' "$release_proof")"
+[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || recovery_fail 'The verified release version must be plain SemVer.'
+evidence_directory="$(recovery_confine_directory ".hexalith/release-evidence/$version/tenants-api-destination")"
+manifest=tools/release-packages.json
+recovery_require_separate_evidence "$evidence_directory"
+case "$(realpath -m -- "$release_proof")/" in "$evidence_directory/"*) recovery_fail 'API evidence overlaps the verified release result.' ;; esac
+mkdir -p "$evidence_directory/reviewed"
+rm -f "$evidence_directory/verified.json"
+cp "$release_proof" "$evidence_directory/reviewed/release.json"
+jq -e --arg source "$source_sha" --arg repository "$repository" --arg version "$version" \
+  '.result == "pass" and .source_sha == $source and .repository == $repository and .version == $version' \
+  "$evidence_directory/reviewed/release.json" >/dev/null || recovery_fail 'The verified normal release result does not match the current source.'
+cp "$receipt" "$evidence_directory/reviewed/receipt.json"
+reviewed_hash="$(sha256sum "$evidence_directory/reviewed/receipt.json" "$evidence_directory/reviewed/release.json")"
+HEXALITH_RECOVERY_CONTAINER_REPOSITORY=tenants-api recovery_verify_container \
+  "$evidence_directory/oci" "$evidence_directory/reviewed/receipt.json"
+[ "$(sha256sum "$evidence_directory/reviewed/receipt.json" "$evidence_directory/reviewed/release.json")" = "$reviewed_hash" ] || recovery_fail 'The reviewed API receipt changed during verification.'
+jq -n --arg source "$source_sha" --arg version "$version" \
+  --arg digest "$(jq -r '.index_digest' "$evidence_directory/oci/oci-validation.json")" \
+  '{result: "pass", source_sha: $source, version: $version, index_digest: $digest}' > "$evidence_directory/verified.json"
+echo "Verified immutable Tenants API image v${version} for source ${source_sha}."
diff --git a/tests/Hexalith.Tenants.Contracts.Tests/ReleaseApiImageVerificationTests.cs b/tests/Hexalith.Tenants.Contracts.Tests/ReleaseApiImageVerificationTests.cs
new file mode 100644
index 00000000..adda96f5
--- /dev/null
+++ b/tests/Hexalith.Tenants.Contracts.Tests/ReleaseApiImageVerificationTests.cs
@@ -0,0 +1,113 @@
+using System.Diagnostics;
+using System.Text.Json;
+
+using Shouldly;
+
+namespace Hexalith.Tenants.Contracts.Tests;
+
+/// <summary>Executes API release binding and refusal before invoking the OCI validator.</summary>
+public class ReleaseApiImageVerificationTests
+{
+    /// <summary>Requires the same release version, source and immutable image as normal publication.</summary>
+    /// <param name="scenario">The reviewed input or fresh observation mutation.</param>
+    [Theory]
+    [InlineData("valid")]
+    [InlineData("missing-api-receipt")]
+    [InlineData("wrong-image")]
+    [InlineData("wrong-release-version")]
+    [InlineData("wrong-release-source")]
+    [InlineData("changed-digest")]
+    public async Task ApiReadbackRequiresTheVerifiedNormalRelease(string scenario)
+    {
+        if (OperatingSystem.IsWindows())
+        {
+            Assert.Skip("Release readback fixtures require bash, jq and python3.");
+        }
+
+        string workspace = Path.Combine(Path.GetTempPath(), "tenants-api-release-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(workspace);
+        try
+        {
+            string release = Path.Combine(workspace, ".hexalith/release-evidence/1.2.3");
+            string receipt = Path.Combine(release, "tenants-api/oci-validation.json");
+            string proof = Path.Combine(release, "destinations/verified.json");
+            string marker = Path.Combine(release, "tenants-api-destination/verified.json");
+            Directory.CreateDirectory(Path.GetDirectoryName(receipt)!);
+            Directory.CreateDirectory(Path.GetDirectoryName(proof)!);
+            Directory.CreateDirectory(Path.GetDirectoryName(marker)!);
+            await File.WriteAllTextAsync(marker, "stale");
+            if (scenario != "missing-api-receipt")
+            {
+                await File.WriteAllTextAsync(receipt, JsonSerializer.Serialize(new
+                {
+                    result = "pass",
+                    image = "registry.example/" + (scenario == "wrong-image" ? "tenants" : "tenants-api") + ":1.2.3",
+                    platforms = new[] { "linux/amd64", "linux/arm64" },
+                    index_digest = "sha256:" + new string('a', 64),
+                    children = new[] { new { provenance_labels = new Dictionary<string, string>
+                    { ["org.opencontainers.image.created"] = "2026-10-31T00:00:00Z" } } },
+                }));
+            }
+            await File.WriteAllTextAsync(proof, JsonSerializer.Serialize(new
+            {
+                result = "pass", repository = "Hexalith/Hexalith.Tenants",
+                version = scenario == "wrong-release-version" ? "1.2.4" : "1.2.3",
+                source_sha = new string(scenario == "wrong-release-source" ? 'b' : 'a', 40),
+            }));
+            string validator = Path.Combine(workspace, "validator.py");
+            await File.WriteAllTextAsync(validator, """
+                import json, os, pathlib, sys
+                args = sys.argv[1:]
+                assert args[args.index('--image') + 1] == 'registry.example/tenants-api:1.2.3'
+                assert args[args.index('--repository') + 1] == 'Hexalith/Hexalith.Tenants'
+                assert args[args.index('--source-sha') + 1] == 'a' * 40
+                assert args[args.index('--version') + 1] == '1.2.3'
+                assert args[args.index('--created') + 1] == '2026-10-31T00:00:00Z'
+                target = pathlib.Path(args[args.index('--evidence-directory') + 1])
+                target.mkdir(parents=True, exist_ok=True)
+                digest = ('b' if os.environ['SCENARIO'] == 'changed-digest' else 'a') * 64
+                (target / 'oci-validation.json').write_text(json.dumps({'index_digest': 'sha256:' + digest}))
+                """);
+            var start = new ProcessStartInfo("bash")
+            {
+                WorkingDirectory = workspace, RedirectStandardOutput = true, RedirectStandardError = true,
+            };
+            start.ArgumentList.Add(Path.Combine(RepositoryRoot(), "scripts/verify-api-release-artifact.sh"));
+            start.Environment["GITHUB_SHA"] = new string('a', 40);
+            start.Environment["GITHUB_REPOSITORY"] = "Hexalith/Hexalith.Tenants";
+            start.Environment["HEXALITH_ZOT_REGISTRY"] = "registry.example";
+            start.Environment["HEXALITH_RELEASE_API_OCI_RECEIPT"] = receipt;
+            start.Environment["HEXALITH_RELEASE_OCI_VALIDATOR"] = validator;
+            start.Environment["SCENARIO"] = scenario;
+            using var process = Process.Start(start)!;
+            Task<string> output = process.StandardOutput.ReadToEndAsync();
+            Task<string> error = process.StandardError.ReadToEndAsync();
+            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(10));
+            try { await process.WaitForExitAsync(timeout.Token); }
+            catch (OperationCanceledException) { process.Kill(entireProcessTree: true); throw; }
+            string diagnostic = await output + await error;
+            if (scenario == "valid")
+            {
+                process.ExitCode.ShouldBe(0, diagnostic);
+                using var verified = JsonDocument.Parse(await File.ReadAllTextAsync(marker));
+                verified.RootElement.GetProperty("version").GetString().ShouldBe("1.2.3");
+                verified.RootElement.GetProperty("source_sha").GetString().ShouldBe(new string('a', 40));
+            }
+            else
+            {
+                process.ExitCode.ShouldNotBe(0, diagnostic);
+                File.Exists(marker).ShouldBeFalse("A refused attempt must revoke its previous successful marker.");
+                if (scenario != "changed-digest")
+                    Directory.Exists(Path.Combine(release, "tenants-api-destination/oci")).ShouldBeFalse("Refusal must precede registry effects.");
+            }
+        }
+        finally { Directory.Delete(workspace, recursive: true); }
+    }
+
+    private static string RepositoryRoot()
+    {
+        for (DirectoryInfo? directory = new(AppContext.BaseDirectory); directory is not null; directory = directory.Parent)
+            if (File.Exists(Path.Combine(directory.FullName, "Hexalith.Tenants.slnx"))) return directory.FullName;
+        throw new InvalidOperationException("The actual Tenants test repository is unavailable.");
+    }
+}
