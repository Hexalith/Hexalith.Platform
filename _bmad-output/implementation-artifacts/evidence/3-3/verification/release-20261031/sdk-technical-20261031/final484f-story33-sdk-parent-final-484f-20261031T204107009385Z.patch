diff --git a/src/Hexalith.EventStore.ServiceDefaults/Routing/RouteCatalogBackgroundBoundary.cs b/src/Hexalith.EventStore.ServiceDefaults/Routing/RouteCatalogBackgroundBoundary.cs
new file mode 100644
index 000000000..736e97c41
--- /dev/null
+++ b/src/Hexalith.EventStore.ServiceDefaults/Routing/RouteCatalogBackgroundBoundary.cs
@@ -0,0 +1,30 @@
+using Hexalith.EventStore.Contracts.Routing;
+
+namespace Hexalith.EventStore.ServiceDefaults.Routing;
+
+/// <summary>Preserves actual RPC enrollment and admits detached work under a separately owned lease of this exact run.</summary>
+internal sealed class RouteCatalogBackgroundBoundary(IRouteCatalogRemoteBoundary inner, IRouteCatalogAuthority authority,
+    RouteCatalogDispatchLease parentLease) : IRouteCatalogRemoteBoundary, IRouteCatalogBackgroundBoundary
+{
+    public void Enroll() => inner.Enroll();
+    public void Retain() => inner.Retain();
+    public void Complete() => inner.Complete();
+
+    public async Task<IRouteCatalogBackgroundWork> AcquireAsync(CancellationToken cancellationToken)
+    {
+        parentLease.RequireOpenForExecution();
+        var parent = parentLease.Snapshot;
+        var lease = await authority.AcquireAsync(cancellationToken).ConfigureAwait(false);
+        try { parentLease.RequireOpenForExecution(); }
+        catch { await lease.DisposeAsync().ConfigureAwait(false); throw; }
+        var child = lease.Snapshot;
+        if (parent.ActivationBindingDigest is null || child.RootDigest != parent.RootDigest || child.Epoch != parent.Epoch
+            || child.ActivationBindingDigest != parent.ActivationBindingDigest || child.LocalAppId != parent.LocalAppId
+            || child.AuthorityCoordinates != parent.AuthorityCoordinates)
+        {
+            await lease.DisposeAsync().ConfigureAwait(false);
+            throw new RouteCatalogUnavailableException("Detached technical work cannot cross its admitted run or receiver identity.");
+        }
+        return new RouteCatalogBackgroundWork(lease, authority);
+    }
+}
diff --git a/src/Hexalith.EventStore.ServiceDefaults/Routing/RouteCatalogBackgroundWork.cs b/src/Hexalith.EventStore.ServiceDefaults/Routing/RouteCatalogBackgroundWork.cs
new file mode 100644
index 000000000..e801840e8
--- /dev/null
+++ b/src/Hexalith.EventStore.ServiceDefaults/Routing/RouteCatalogBackgroundWork.cs
@@ -0,0 +1,43 @@
+using Hexalith.EventStore.Contracts.Routing;
+
+namespace Hexalith.EventStore.ServiceDefaults.Routing;
+
+/// <summary>Replaces inherited request scopes with the separately acquired lifetime of one existing detached workflow.</summary>
+internal sealed class RouteCatalogBackgroundWork(RouteCatalogDispatchLease lease, IRouteCatalogAuthority authority) : IRouteCatalogBackgroundWork
+{
+    private readonly object _gate = new();
+    private readonly TaskCompletionSource _completed = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    private int _state;
+
+    public async Task RunAsync(Func<Task> execute)
+    {
+        ArgumentNullException.ThrowIfNull(execute);
+        lock (_gate)
+        {
+            if (_state != 0) throw new RouteCatalogUnavailableException("Detached catalog work is disposed or has already executed.");
+            _state = 1;
+        }
+        try
+        {
+            lease.RequireOpenForExecution();
+            using var scope = new RouteCatalogRemoteScope(lease, isolated: true);
+            RouteCatalogRemoteExecution.Current = new RouteCatalogBackgroundBoundary(RouteCatalogRemoteExecution.Current!, authority, lease);
+            await execute().ConfigureAwait(false);
+        }
+        finally
+        {
+            try { await lease.DisposeAsync().ConfigureAwait(false); }
+            finally { lock (_gate) _state = 2; _completed.TrySetResult(); }
+        }
+    }
+
+    public ValueTask DisposeAsync()
+    {
+        lock (_gate)
+        {
+            if (_state == 1) return new(_completed.Task);
+            _state = 2;
+        }
+        return lease.DisposeAsync();
+    }
+}
