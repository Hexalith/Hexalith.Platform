       Keep this inside the sealed early entry point so owner early props see the pin once. -->
  <Import Project="$(MSBuildThisFileDirectory)pinned-tree/Props/Directory.Packages.props" Condition="'$(HexalithPinnedModelCatalogBuild)' == 'true'" />
  <UsingTask TaskName="Hexalith.Builds.Tooling.Workspace.SourceMappingValidationTask" AssemblyFile="/home/administrator/projects/hexalith/platform/tests/Hexalith.Platform.Composition.Tests/bin/Debug/net10.0/Hexalith.Builds.Tooling.dll" />
  <UsingTask TaskName="Hexalith.Builds.Tooling.Workspace.SourceMappingReconciliationTask" AssemblyFile="/home/administrator/projects/hexalith/platform/tests/Hexalith.Platform.Composition.Tests/bin/Debug/net10.0/Hexalith.Builds.Tooling.dll" />
  <UsingTask TaskName="Hexalith.Builds.Tooling.Workspace.CatalogVersionValidationTask" AssemblyFile="/home/administrator/projects/hexalith/platform/tests/Hexalith.Platform.Composition.Tests/bin/Debug/net10.0/Hexalith.Builds.Tooling.dll" />
  <Import Project="$(MSBuildThisFileDirectory)SourceMapping.values.targets" />
</Project>
