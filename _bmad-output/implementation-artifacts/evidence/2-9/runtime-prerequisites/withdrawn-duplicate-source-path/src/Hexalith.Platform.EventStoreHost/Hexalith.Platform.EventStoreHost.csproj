<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><IsPackable>false</IsPackable><EnableContainer>true</EnableContainer><ContainerRepository>eventstore</ContainerRepository></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Hexalith.Platform.Identity/Hexalith.Platform.Identity.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Hexalith.Platform.Protection/Hexalith.Platform.Protection.csproj" /></ItemGroup>
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' == 'true' and '$(EnableLegacyDevelopmentCatalog)' == 'true'">
    <DefineConstants>$(DefineConstants);HEXALITH_PLATFORM_SOURCE_CATALOG</DefineConstants>
    <HexalithPartiesCatalogRoot Condition="'$(HexalithPartiesRoot)' != ''">$(HexalithPartiesRoot)</HexalithPartiesCatalogRoot>
    <HexalithPartiesCatalogRoot Condition="'$(HexalithPartiesCatalogRoot)' == ''">$(MSBuildThisFileDirectory)../../references/Hexalith.Parties</HexalithPartiesCatalogRoot>
    <HexalithTenantsCatalogRoot Condition="'$(HexalithTenantsRoot)' != ''">$(HexalithTenantsRoot)</HexalithTenantsCatalogRoot>
    <HexalithTenantsCatalogRoot Condition="'$(HexalithTenantsCatalogRoot)' == ''">$(MSBuildThisFileDirectory)../../references/Hexalith.Tenants</HexalithTenantsCatalogRoot>
    <HexalithMemoriesCatalogRoot Condition="'$(HexalithMemoriesRoot)' != ''">$(HexalithMemoriesRoot)</HexalithMemoriesCatalogRoot>
    <HexalithMemoriesCatalogRoot Condition="'$(HexalithMemoriesCatalogRoot)' == ''">$(MSBuildThisFileDirectory)../../references/Hexalith.Memories</HexalithMemoriesCatalogRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'true' and '$(EnableLegacyDevelopmentCatalog)' == 'true'">
    <ProjectReference Include="$(HexalithPartiesCatalogRoot)/src/Hexalith.Parties.EventStoreExtensions/Hexalith.Parties.EventStoreExtensions.csproj" AdditionalProperties="UseHexalithProjectReferences=true;UseNuGetDeps=false;HexalithEventStoreFromSource=true;HexalithMcpCliFromSource=true;HexalithCommonsFromSource=true" />
    <ProjectReference Include="$(HexalithTenantsCatalogRoot)/src/Hexalith.Tenants.Server/Hexalith.Tenants.Server.csproj" AdditionalProperties="UseHexalithProjectReferences=true;UseNuGetDeps=false;HexalithEventStoreFromSource=true;HexalithMcpCliFromSource=true;HexalithCommonsFromSource=true" />
    <ProjectReference Include="$(HexalithMemoriesCatalogRoot)/src/Hexalith.Memories.EventStoreExtensions/Hexalith.Memories.EventStoreExtensions.csproj" AdditionalProperties="UseHexalithProjectReferences=true;UseNuGetDeps=false;HexalithEventStoreFromSource=true;HexalithMcpCliFromSource=true;HexalithCommonsFromSource=true" />
  </ItemGroup>
</Project>
