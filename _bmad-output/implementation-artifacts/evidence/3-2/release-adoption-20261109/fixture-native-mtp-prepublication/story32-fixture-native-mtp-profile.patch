@@ -0,0 +1,31 @@
+#!/usr/bin/env python3
+"""Run the publisher's exact resource-free control inventory before qualification."""
+from pathlib import Path
+import sys
+import unittest
+
+
+def cases(suite):
+    for item in suite:
+        if isinstance(item, unittest.TestSuite):
+            yield from cases(item)
+        else:
+            yield item
+
+
+def main():
+    suite = unittest.defaultTestLoader.discover(str(Path(__file__).resolve().parent), pattern="test_*.py")
+    inventory = {}
+    for case in cases(suite):
+        module = case.__class__.__module__
+        inventory[module] = inventory.get(module, 0) + 1
+    expected = {"test_host_entry": 14, "test_package": 9}
+    if inventory != expected:
+        print(f"Publisher control inventory differs: expected {expected}, actual {inventory}", file=sys.stderr)
+        return 1
+    print(f"Publisher controls: {sum(inventory.values())} (14 readiness, 9 archive identity).", flush=True)
+    return 0 if unittest.TextTestRunner(verbosity=2).run(suite).wasSuccessful() else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
