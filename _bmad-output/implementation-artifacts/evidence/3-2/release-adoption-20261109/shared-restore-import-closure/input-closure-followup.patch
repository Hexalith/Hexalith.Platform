+                    path.write_bytes((prepare.ROOT / name).read_bytes())
+                    control.rebind_source()
+                prepare.validate_profile(control.profile, control.root, control.graph)
+                if fault == 'deleted':
+                    path.unlink()
+                elif fault == 'modified':
