+        path.parent.mkdir()
+        project.write(path, encoding="utf-8")
+        result = self.invoke(path, ["-p:UseHexalithProjectReferences=true"])
+        return next(item for item in result["Items"]["ProjectReference"]
+                    if item["Filename"] == "Hexalith.EventStore.DomainService")
+
+    def test_removed_sdk_property_is_not_reintroduced_case_insensitively(self):
+        for removal in ["HexalithEventStoreVersion", "Other; hexalithEVENTSTOREversion ;Keep"]:
+            with self.subTest(removal=removal):
+                edge = self.removal_edge(removal)
