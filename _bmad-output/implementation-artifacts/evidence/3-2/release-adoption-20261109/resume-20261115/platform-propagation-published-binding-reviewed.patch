+                self.assertEqual(removal, edge["GlobalPropertiesToRemove"])
+        edge = self.removal_edge("HexalithEventStoreVersionFuture")
+        self.assertIn("HexalithEventStoreVersion=" + self.default_sdk, edge["AdditionalProperties"])
