<Project>
  <!-- The model builder opts in only after verifying the command's materialized catalog closure.
       Keep this inside the sealed early entry point so owner early props see the pin once. -->
  <Import Project="$(MSBuildThisFileDirectory)pinned-tree/Props/Directory.Packages.props" Condition="'$(HexalithPinnedModelCatalogBuild)' == 'true'" />
  <UsingTask TaskName="Hexalith.Builds.Tooling.Workspace.SourceMappingValidationTask" AssemblyFile="/home/administrator/.nuget/packages/hexalith.builds.module.cli/4.43.6/tools/net10.0/any/Hexalith.Builds.Tooling.dll" />
  <UsingTask TaskName="Hexalith.Builds.Tooling.Workspace.SourceMappingReconciliationTask" AssemblyFile="/home/administrator/.nuget/packages/hexalith.builds.module.cli/4.43.6/tools/net10.0/any/Hexalith.Builds.Tooling.dll" />
  <UsingTask TaskName="Hexalith.Builds.Tooling.Workspace.CatalogVersionValidationTask" AssemblyFile="/home/administrator/.nuget/packages/hexalith.builds.module.cli/4.43.6/tools/net10.0/any/Hexalith.Builds.Tooling.dll" />
  <Import Project="$(MSBuildThisFileDirectory)SourceMapping.values.targets" />
</Project>
