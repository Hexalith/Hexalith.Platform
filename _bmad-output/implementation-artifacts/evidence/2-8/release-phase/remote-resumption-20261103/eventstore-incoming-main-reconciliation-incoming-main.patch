+using Hexalith.EventStore.Contracts.Routing;
+using Hexalith.EventStore.ServiceDefaults.Routing;
+
+using Microsoft.Extensions.Hosting;
+using Microsoft.Extensions.Options;
+
+using NSubstitute;
