diff --git a/tests/Hexalith.Parties.Platform.IntegrationTests/NativeAssemblyObservationTests.cs b/tests/Hexalith.Parties.Platform.IntegrationTests/NativeAssemblyObservationTests.cs
new file mode 100644
index 00000000..6e76ca77
--- /dev/null
+++ b/tests/Hexalith.Parties.Platform.IntegrationTests/NativeAssemblyObservationTests.cs
@@ -0,0 +1,82 @@
+namespace Hexalith.Parties.Platform.IntegrationTests;
+
+using System.Security.Cryptography;
+using System.Text.Json;
+
+using Shouldly;
+
+/// <summary>Exercises actual local diagnostic file boundaries without simulating a CI or native owner.</summary>
+public sealed class NativeAssemblyObservationTests
+{
+    /// <summary>Preserves the original private diagnostic and refuses a duplicate write.</summary>
+    [Fact]
+    public void PrivateDiagnosticRetainsFirstBytesAndRefusesOverwrite()
+    {
+        if (!OperatingSystem.IsLinux()) throw new PlatformNotSupportedException("This file boundary control requires Linux.");
+        string directory = Directory.CreateTempSubdirectory("parties-diagnostic-io-control-").FullName;
+        try
+        {
+            const string fileIdentity = "local-io-control";
+            const string observation = "{\"scope\":\"local-file-control-no-native-credit\"}";
+            NativeAssemblyObservations.WritePrivateObservation(directory, fileIdentity, observation);
+            string path = Path.Combine(directory, "loaded-assemblies-" + fileIdentity + ".json");
+            byte[] original = File.ReadAllBytes(path);
+            File.GetUnixFileMode(path).ShouldBe(UnixFileMode.UserRead | UnixFileMode.UserWrite);
+            Should.Throw<IOException>(() => NativeAssemblyObservations.WritePrivateObservation(directory, fileIdentity, "replacement"));
+            File.ReadAllBytes(path).ShouldBe(original);
+        }
+        finally { Directory.Delete(directory, recursive: true); }
+    }
+
+    /// <summary>Refuses a linked directory before creating any diagnostic file.</summary>
+    [Fact]
+    public void PrivateDiagnosticRefusesSymbolicDirectory()
+    {
+        if (!OperatingSystem.IsLinux()) throw new PlatformNotSupportedException("This file boundary control requires Linux.");
+        string directory = Directory.CreateTempSubdirectory("parties-diagnostic-link-control-").FullName;
+        try
+        {
+            string target = Directory.CreateDirectory(Path.Combine(directory, "target")).FullName;
+            string linked = Path.Combine(directory, "linked");
+            Directory.CreateSymbolicLink(linked, target);
+            Should.Throw<IOException>(() => NativeAssemblyObservations.WritePrivateObservation(linked, "local-io-control", "{}"));
+            Directory.GetFiles(target).ShouldBeEmpty();
+        }
+        finally { Directory.Delete(directory, recursive: true); }
+    }
+    /// <summary>Reads a real local output file as metadata without loading it for evidence.</summary>
+    [Fact]
+    public void CopiedOutputReportsActualFileHashWithoutLoadingIt()
+    {
+        string directory = Directory.CreateTempSubdirectory("parties-local-output-control-").FullName;
+        try
+        {
+            string path = Path.Combine(directory, "Hexalith.LocalControl.dll");
+            File.Copy(typeof(NativeAssemblyObservationTests).Assembly.Location, path);
+            AppDomain.CurrentDomain.GetAssemblies().Any(value => !value.IsDynamic && value.Location == path).ShouldBeFalse();
+            object[] observations = NativeAssemblyObservations.ReadCompositionOutput(path);
+            AppDomain.CurrentDomain.GetAssemblies().Any(value => !value.IsDynamic && value.Location == path).ShouldBeFalse();
+            using JsonDocument output = JsonDocument.Parse(JsonSerializer.Serialize(observations));
+            JsonElement observed = output.RootElement.EnumerateArray().Single();
+            observed.GetProperty("scope").GetString().ShouldBe("copied-native-composition-output");
+            observed.GetProperty("copiedPath").GetString().ShouldBe(path);
+            observed.GetProperty("sha256").GetString().ShouldBe(Convert.ToHexStringLower(SHA256.HashData(File.ReadAllBytes(path))));
+        }
+        finally { Directory.Delete(directory, recursive: true); }
+    }
+
+    /// <summary>Refuses a linked copied output rather than presenting another file as native output.</summary>
+    [Fact]
+    public void CopiedOutputRefusesLinkedAssembly()
+    {
+        string directory = Directory.CreateTempSubdirectory("parties-linked-output-control-").FullName;
+        try
+        {
+            string path = Path.Combine(directory, "Hexalith.LocalControl.dll");
+            File.CreateSymbolicLink(path, typeof(NativeAssemblyObservationTests).Assembly.Location);
+            Should.Throw<InvalidDataException>(() => NativeAssemblyObservations.ReadCompositionOutput(path));
+        }
+        finally { Directory.Delete(directory, recursive: true); }
+    }
+
+}
diff --git a/tests/Hexalith.Parties.Platform.IntegrationTests/NativeAssemblyObservations.cs b/tests/Hexalith.Parties.Platform.IntegrationTests/NativeAssemblyObservations.cs
new file mode 100644
index 00000000..b7292193
--- /dev/null
+++ b/tests/Hexalith.Parties.Platform.IntegrationTests/NativeAssemblyObservations.cs
@@ -0,0 +1,113 @@
+namespace Hexalith.Parties.Platform.IntegrationTests;
+
+using System.Diagnostics;
+using System.Reflection;
+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+
+/// <summary>Retains bounded identities of SDK assemblies already loaded by the real native test.</summary>
+internal static class NativeAssemblyObservations
+{
+    /// <summary>Writes actual test-process measurements after the persistence assertions have passed.</summary>
+    /// <param name="output">The native TRX diagnostic channel.</param>
+    /// <param name="ownerRunId">The validated descriptor's actual owner run.</param>
+    internal static void Write(ITestOutputHelper output, string ownerRunId)
+    {
+        NativeDiagnosticBinding binding = NativeDiagnosticBinding.Read(ownerRunId);
+        var loaded = AppDomain.CurrentDomain.GetAssemblies()
+            .Where(assembly => !assembly.IsDynamic && (assembly.GetName().Name!.StartsWith("Hexalith.", StringComparison.Ordinal)
+                || assembly.GetName().Name == "StackExchange.Redis"))
+            .OrderBy(assembly => assembly.FullName, StringComparer.Ordinal)
+            .Take(65)
+            .Select(assembly =>
+            {
+                using FileStream bytes = File.OpenRead(assembly.Location);
+                return new
+                {
+                    scope = "loaded-native-test-process",
+                    identity = assembly.FullName,
+                    informationalVersion = assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion,
+                    moduleVersionId = assembly.ManifestModule.ModuleVersionId,
+                    loadedPath = assembly.Location,
+                    sha256 = Convert.ToHexStringLower(SHA256.HashData(bytes)),
+                };
+            }).ToArray();
+        var copied = ReadCompositionOutput(binding.ModelAssemblyPath);
+        string observation = JsonSerializer.Serialize(new
+        {
+            kind = "real-native-sdk-assemblies",
+            ownerRunId,
+            ownerAttemptId = binding.AttemptId,
+            environmentId = binding.EnvironmentId,
+            revision = binding.Revision,
+            mappingHash = binding.MappingHash,
+            executionContext = binding.ExecutionContext,
+            loaded,
+            copied,
+        });
+        if (loaded.Length is 0 or > 64 || copied.Length is 0 or > 64 || Encoding.UTF8.GetByteCount(observation) > 65536)
+            throw new InvalidOperationException("The native loaded-assembly observation exceeds its bounded diagnostic contract.");
+        output.WriteLine(observation);
+        RetainHostedObservation(observation, binding);
+    }
+
+    /// <summary>Measures actual copied native model output without loading assemblies merely for diagnostics.</summary>
+    /// <param name="modelAssemblyPath">The exact output path cross-bound to the existing native plan.</param>
+    /// <returns>Identities and hashes of SDK files actually copied beside that model.</returns>
+    internal static object[] ReadCompositionOutput(string modelAssemblyPath)
+    {
+        string directory = Path.GetDirectoryName(modelAssemblyPath)!;
+        for (DirectoryInfo? parent = new(directory); parent is not null; parent = parent.Parent)
+            if (parent.LinkTarget is not null) throw new IOException("Native SDK output cannot traverse symbolic links.");
+        if (!File.Exists(modelAssemblyPath) || new FileInfo(modelAssemblyPath).LinkTarget is not null)
+            throw new InvalidDataException("The actual prepared native composition output is unavailable.");
+        return Directory.EnumerateFiles(directory, "Hexalith.*.dll", SearchOption.TopDirectoryOnly)
+            .Order(StringComparer.Ordinal).Take(65).Select(path =>
+            {
+                if (new FileInfo(path).LinkTarget is not null) throw new IOException("Native SDK output cannot use linked files.");
+                using FileStream bytes = File.OpenRead(path);
+                return (object)new
+                {
+                    scope = "copied-native-composition-output",
+                    identity = AssemblyName.GetAssemblyName(path).FullName,
+                    informationalVersion = FileVersionInfo.GetVersionInfo(path).ProductVersion,
+                    copiedPath = path,
+                    sha256 = Convert.ToHexStringLower(SHA256.HashData(bytes)),
+                };
+            }).ToArray();
+    }
+
+    /// <summary>Preserves the bounded diagnostic in the existing classified integration upload before teardown.</summary>
+    /// <param name="observation">The measured test-process assemblies and actual run bindings.</param>
+    /// <param name="binding">The actual descriptor, mapping and owner metadata binding.</param>
+    private static void RetainHostedObservation(string observation, NativeDiagnosticBinding binding)
+    {
+        if (binding.ExecutionContext.GetProperty("kind").GetString() == "local") return;
+        if (binding.ExecutionContext.GetProperty("kind").GetString() != "ci" || !OperatingSystem.IsLinux())
+            throw new InvalidDataException("Native diagnostic retention requires the actual CI owner metadata.");
+        binding.VerifyCallerArtifact();
+        WritePrivateObservation(binding.ArtifactDirectory, binding.RunId, observation);
+    }
+
+    /// <summary>Writes once through non-linked directories using private file creation.</summary>
+    /// <param name="directory">The existing classified output directory.</param>
+    /// <param name="ownerRunId">The descriptor-bound diagnostic filename suffix.</param>
+    /// <param name="observation">The previously bounded diagnostic JSON.</param>
+    internal static void WritePrivateObservation(string directory, string ownerRunId, string observation)
+    {
+        if (!OperatingSystem.IsLinux()) throw new PlatformNotSupportedException("Hosted native diagnostic retention requires Linux.");
+        for (DirectoryInfo? parent = new(directory); parent is not null; parent = parent.Parent)
+            if (parent.LinkTarget is not null) throw new IOException("Native diagnostic output cannot traverse symbolic links.");
+        FileStreamOptions options = new()
+        {
+            Mode = FileMode.CreateNew,
+            Access = FileAccess.Write,
+            Share = FileShare.None,
+            UnixCreateMode = UnixFileMode.UserRead | UnixFileMode.UserWrite,
+        };
+        using FileStream stream = new(Path.Combine(directory, "loaded-assemblies-" + ownerRunId + ".json"), options);
+        stream.Write(Encoding.UTF8.GetBytes(observation + "\n"));
+    }
+
+}
diff --git a/tests/Hexalith.Parties.Platform.IntegrationTests/NativeDiagnosticBinding.cs b/tests/Hexalith.Parties.Platform.IntegrationTests/NativeDiagnosticBinding.cs
new file mode 100644
index 00000000..60435889
--- /dev/null
+++ b/tests/Hexalith.Parties.Platform.IntegrationTests/NativeDiagnosticBinding.cs
@@ -0,0 +1,210 @@
+namespace Hexalith.Parties.Platform.IntegrationTests;
+
+using System.Diagnostics;
+using System.Security.Cryptography;
+using System.Text.Json;
+
+/// <summary>Reads only the existing native handoff and cross-bound, credential-free owner metadata.</summary>
+/// <param name="RunId">The descriptor-issued owner run.</param>
+/// <param name="AttemptId">The descriptor-issued owner attempt.</param>
+/// <param name="EnvironmentId">The descriptor-issued environment.</param>
+/// <param name="OwnerWorkspace">The disposable owner workspace.</param>
+/// <param name="CallerRoot">The original Git root selected by the verified mapping.</param>
+/// <param name="Revision">That root's actual Git HEAD at measurement time.</param>
+/// <param name="MappingHash">The verified immutable source mapping.</param>
+/// <param name="ExecutionContext">The actual context shared by descriptor and issued owner state.</param>
+/// <param name="StateDirectory">The plan-bound existing owner metadata directory.</param>
+/// <param name="ModelAssemblyPath">The actual prepared native composition output declared by the plan.</param>
+/// <param name="Profile">The original selected declared native profile.</param>
+internal sealed record NativeDiagnosticBinding(string RunId, string AttemptId, string EnvironmentId,
+    string OwnerWorkspace, string CallerRoot, string Revision, string MappingHash, JsonElement ExecutionContext, string StateDirectory, string ModelAssemblyPath, string Profile)
+{
+    /// <summary>Gets the original caller's existing classified artifact directory, outside disposable workspaces.</summary>
+    internal string ArtifactDirectory => Path.Combine(CallerRoot, "TestResults", Profile switch
+    {
+        "platform-package" => "module-integration",
+        "lifecycle-package" => "ci-lifecycle",
+        _ => throw new InvalidDataException("Native diagnostic profile has no declared caller artifact route."),
+    });
+
+    /// <summary>Consumes only variables explicitly passed by the published native executor.</summary>
+    /// <param name="runId">The fixture's validated owner run.</param>
+    /// <returns>The cross-bound public diagnostic identity.</returns>
+    internal static NativeDiagnosticBinding Read(string runId) => Read(runId, new[]
+    {
+        "HEXALITH_G4_RUN_ID", "HEXALITH_TEST_ENVIRONMENT_PATH", "HEXALITH_G4_PLAN_PATH",
+        "HEXALITH_G4_TEST_REPORT_PATH", "HEXALITH_G4_SOURCE_MAPPING_PATH", "HEXALITH_SOURCE_MAPPING_HASH",
+    }.ToDictionary(name => name, name => Environment.GetEnvironmentVariable(name) ?? string.Empty, StringComparer.Ordinal));
+
+    /// <summary>Validates the exact handoff without requiring stripped GitHub environment variables.</summary>
+    /// <param name="runId">The already validated fixture owner.</param>
+    /// <param name="handoff">Only the published native handoff fields.</param>
+    /// <returns>The actual existing ownership and caller-output binding.</returns>
+    internal static NativeDiagnosticBinding Read(string runId, IReadOnlyDictionary<string, string> handoff)
+    {
+        if (runId.Length != 32 || runId.Any(value => value is not (>= '0' and <= '9' or >= 'a' and <= 'f'))
+            || handoff["HEXALITH_G4_RUN_ID"] != runId) throw new InvalidDataException("Native diagnostic owner mismatch.");
+        string workspace = Path.GetDirectoryName(Path.GetFullPath(handoff["HEXALITH_TEST_ENVIRONMENT_PATH"]))!;
+        RequireEqual(handoff["HEXALITH_TEST_ENVIRONMENT_PATH"], Path.Combine(workspace, "test-environment.json"));
+        RequireEqual(handoff["HEXALITH_G4_PLAN_PATH"], Path.Combine(workspace, "plan.json"));
+        RequireEqual(handoff["HEXALITH_G4_TEST_REPORT_PATH"], Path.Combine(workspace, "native-tests", "native.trx"));
+        RequireEqual(handoff["HEXALITH_G4_SOURCE_MAPPING_PATH"], Path.Combine(workspace, "source-mapping", "mapping.json"));
+        using JsonDocument descriptor = ReadDocument(handoff["HEXALITH_TEST_ENVIRONMENT_PATH"]);
+        using JsonDocument plan = ReadDocument(handoff["HEXALITH_G4_PLAN_PATH"]);
+        using JsonDocument mapping = ReadDocument(handoff["HEXALITH_G4_SOURCE_MAPPING_PATH"]);
+        JsonElement selected = mapping.RootElement;
+        string hash = handoff["HEXALITH_SOURCE_MAPPING_HASH"];
+        VerifyMapping(selected, plan.RootElement, hash);
+        RequireEqual(plan.RootElement.GetProperty("schema").GetString(), "hexalith.g4-run-plan.v1");
+        RequireEqual(plan.RootElement.GetProperty("runId").GetString(), runId);
+        RequireEqual(plan.RootElement.GetProperty("workspace").GetString(), workspace);
+        string stateDirectory = plan.RootElement.GetProperty("resourceClaimStateDirectory").GetString()!;
+        using JsonDocument state = ReadDocument(Path.Combine(stateDirectory, runId + ".json"));
+        JsonElement run = descriptor.RootElement.GetProperty("bindings").GetProperty("run");
+        VerifyOwner(runId, workspace, run, plan.RootElement, state.RootElement);
+        JsonElement context = descriptor.RootElement.GetProperty("bindings").GetProperty("environment").GetProperty("executionContext");
+        if (!JsonElement.DeepEquals(context, state.RootElement.GetProperty("executionContext")))
+            throw new InvalidDataException("Native diagnostic execution context mismatch.");
+        VerifyContext(context);
+        string root = Path.TrimEndingDirectorySeparator(Path.GetFullPath(selected.GetProperty("Root").GetString()!));
+        VerifyDirectory(root);
+        if (Path.GetFullPath(root).StartsWith(workspace + Path.DirectorySeparatorChar, StringComparison.Ordinal) || root == workspace)
+            throw new InvalidDataException("Disposable native workspaces cannot select the caller artifact root.");
+        string model = plan.RootElement.GetProperty("platformModelAssemblyPath").GetString()!;
+        RequireEqual(model, Path.Combine(workspace, "hosts", "platform-model", "Hexalith.Platform.Composition.dll"));
+        return new(runId, run.GetProperty("attemptId").GetString()!, run.GetProperty("environmentId").GetString()!,
+            workspace, root, ReadRevision(root), hash, context.Clone(), stateDirectory, model, plan.RootElement.GetProperty("selectedTest").GetProperty("name").GetString()!);
+    }
+
+    /// <summary>Verifies the original caller helper declared this artifact directory for the exact job and profile.</summary>
+    internal void VerifyCallerArtifact()
+    {
+        if (Profile == "platform-package")
+        {
+            using JsonDocument invocation = ReadDocument(Path.Combine(ArtifactDirectory, "invocation.json"));
+            RequireEqual(invocation.RootElement.GetProperty("classification").GetString(), "baseline-only");
+            if (!JsonElement.DeepEquals(ExecutionContext, invocation.RootElement.GetProperty("executionContext"))
+                || !invocation.RootElement.GetProperty("profiles").EnumerateArray().Any(value => value.GetString() == Profile))
+                throw new InvalidDataException("Native diagnostics differ from the original caller artifact invocation.");
+            return;
+        }
+        VerifyLifecycleArtifact(Path.Combine(ArtifactDirectory, "observations.json"));
+    }
+
+    /// <summary>Checks a classified lifecycle journal against this already verified owner, source and context.</summary>
+    /// <param name="journalPath">The existing caller journal, or a local metadata boundary control.</param>
+    internal void VerifyLifecycleArtifact(string journalPath)
+    {
+        using JsonDocument journal = ReadDocument(journalPath);
+        JsonElement recorded = journal.RootElement;
+        RequireEqual(recorded.GetProperty("schema").GetString(), "hexalith.ci-lifecycle-qualification.v1");
+        RequireEqual(recorded.GetProperty("classification").GetString(), "baseline-only");
+        RequireEqual(recorded.GetProperty("source").GetString(), Revision);
+        RequireEqual(recorded.GetProperty("mappingHash").GetString(), MappingHash);
+        if (!JsonElement.DeepEquals(ExecutionContext, recorded.GetProperty("executionContext")))
+            throw new InvalidDataException("Native diagnostics differ from the existing lifecycle journal context.");
+        int matches = 0;
+        foreach (JsonElement owner in recorded.GetProperty("owners").EnumerateArray())
+        {
+            string label = owner.GetProperty("label").GetString()!;
+            if (label is not ("passing" or "failing" or "peer" or "retry" or "partial" or "cancel"))
+                throw new InvalidDataException("Native diagnostic lifecycle owner role is unknown.");
+            string receiptPath = owner.GetProperty("receipt").GetString()!;
+            DirectoryInfo role = new(Path.GetDirectoryName(receiptPath)!);
+            if (Path.GetFileName(receiptPath) != "receipt.json" || role.Name != label || role.Parent?.Name != "hexalith-ci-qualification")
+                throw new InvalidDataException("Native diagnostic receipt escaped its existing controller role.");
+            if (!File.Exists(receiptPath)) continue; // A sibling launch intent may not yet have an issued receipt.
+            using JsonDocument receipt = ReadDocument(receiptPath);
+            JsonElement issued = receipt.RootElement;
+            if (issued.GetProperty("runId").GetString() != RunId) continue;
+            RequireEqual(issued.GetProperty("schema").GetString(), "hexalith.module.ci-owner-receipt.v1");
+            RequireEqual(issued.GetProperty("attemptId").GetString(), AttemptId);
+            RequireEqual(issued.GetProperty("environmentId").GetString(), EnvironmentId);
+            RequireEqual(issued.GetProperty("stateDirectory").GetString(), StateDirectory);
+            if (!JsonElement.DeepEquals(ExecutionContext, issued.GetProperty("executionContext")))
+                throw new InvalidDataException("Native diagnostic lifecycle receipt context changed.");
+            matches++;
+        }
+        if (matches != 1) throw new InvalidDataException("Native diagnostic lifecycle owner has no unique issued receipt.");
+    }
+
+    private static void VerifyMapping(JsonElement mapping, JsonElement plan, string hash)
+    {
+        string[] fields = ["Mode", "Root", "ActiveModule", "Entries", "HasGit", "PlatformIdentity", "IdentityFindings"];
+        var original = fields.ToDictionary(name => name, mapping.GetProperty, StringComparer.Ordinal);
+        string calculated = Convert.ToHexStringLower(SHA256.HashData(JsonSerializer.SerializeToUtf8Bytes(original)));
+        RequireEqual(calculated, hash);
+        RequireEqual(mapping.GetProperty("ContentHash").GetString(), hash);
+        RequireEqual(plan.GetProperty("sourceMappingHash").GetString(), hash);
+        RequireEqual(plan.GetProperty("sourceMapping").GetProperty("contentHash").GetString(), hash);
+        RequireEqual(plan.GetProperty("sourceMapping").GetProperty("root").GetString(), mapping.GetProperty("Root").GetString());
+        if (!mapping.GetProperty("HasGit").GetBoolean()) throw new InvalidDataException("Native diagnostic caller requires its real Git root.");
+    }
+
+    private static void VerifyContext(JsonElement context)
+    {
+        string kind = context.GetProperty("kind").GetString()!;
+        string[] names = kind == "local" ? ["kind"]
+            : ["kind", "repository", "workflowRunId", "workflowAttempt", "jobId", "runnerKind", "operatingSystem", "disposable"];
+        if (context.EnumerateObject().Select(property => property.Name).Order(StringComparer.Ordinal)
+            .SequenceEqual(names.Order(StringComparer.Ordinal)) is false || kind is not ("local" or "ci"))
+            throw new InvalidDataException("Native diagnostic context has unexpected fields.");
+        if (kind == "local") return;
+        RequireEqual(context.GetProperty("runnerKind").GetString(), "github-hosted");
+        RequireEqual(context.GetProperty("operatingSystem").GetString(), "Linux");
+        if (!context.GetProperty("disposable").GetBoolean() || context.GetProperty("workflowAttempt").GetInt32() <= 0
+            || new[] { "repository", "workflowRunId", "jobId" }.Any(name => string.IsNullOrWhiteSpace(context.GetProperty(name).GetString())))
+            throw new InvalidDataException("Native diagnostic CI context is incomplete.");
+    }
+
+    private static void VerifyOwner(string runId, string workspace, JsonElement run, JsonElement plan, JsonElement state)
+    {
+        RequireEqual(state.GetProperty("schema").GetString(), "hexalith.g4-run-state.v1");
+        RequireEqual(state.GetProperty("runId").GetString(), runId);
+        RequireEqual(state.GetProperty("workspace").GetString(), workspace);
+        RequireEqual(run.GetProperty("runId").GetString(), runId);
+        RequireEqual(run.GetProperty("ownerRunId").GetString(), runId);
+        RequireEqual(run.GetProperty("role").GetString(), "owner");
+        foreach (string name in new[] { "attemptId", "environmentId" })
+        {
+            string value = run.GetProperty(name).GetString()!;
+            RequireEqual(state.GetProperty(name).GetString(), value);
+            RequireEqual(plan.GetProperty(name).GetString(), value);
+        }
+    }
+
+    private static JsonDocument ReadDocument(string path)
+    {
+        VerifyDirectory(Path.GetDirectoryName(Path.GetFullPath(path))!);
+        FileInfo file = new(path);
+        if (!Path.IsPathFullyQualified(path) || file.LinkTarget is not null || file.Length is <= 0 or > 4194304)
+            throw new InvalidDataException("Native diagnostic metadata must be bounded regular non-linked files.");
+        return JsonDocument.Parse(File.ReadAllBytes(path));
+    }
+
+    private static void VerifyDirectory(string path)
+    {
+        if (!Path.IsPathFullyQualified(path) || !Directory.Exists(path)) throw new InvalidDataException("Native diagnostic directory is unavailable.");
+        for (DirectoryInfo? parent = new(path); parent is not null; parent = parent.Parent)
+            if (parent.LinkTarget is not null) throw new IOException("Native diagnostic paths cannot traverse links.");
+    }
+
+    private static string ReadRevision(string root)
+    {
+        ProcessStartInfo start = new("git") { WorkingDirectory = root, RedirectStandardOutput = true, RedirectStandardError = true, UseShellExecute = false };
+        start.ArgumentList.Add("rev-parse"); start.ArgumentList.Add("--show-toplevel"); start.ArgumentList.Add("HEAD");
+        using Process child = Process.Start(start) ?? throw new IOException("Cannot inspect the original caller Git root.");
+        Task<string> output = child.StandardOutput.ReadToEndAsync(); Task<string> error = child.StandardError.ReadToEndAsync();
+        if (!child.WaitForExit(5000)) { child.Kill(entireProcessTree: true); throw new IOException("Caller Git identity inspection exceeded its finite bound."); }
+        _ = error.GetAwaiter().GetResult();
+        string[] lines = output.GetAwaiter().GetResult().Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
+        if (child.ExitCode != 0 || lines.Length != 2 || lines[0] != root || lines[1].Length != 40 || lines[1].Any(value => !char.IsAsciiHexDigit(value)))
+            throw new InvalidDataException("Original caller Git identity cannot be verified.");
+        return lines[1];
+    }
+
+    private static void RequireEqual(string? actual, string? expected)
+    {
+        if (string.IsNullOrEmpty(actual) || actual != expected) throw new InvalidDataException("Native diagnostic metadata binding mismatch.");
+    }
+}
diff --git a/tests/Hexalith.Parties.Platform.IntegrationTests/NativeDiagnosticBindingTests.cs b/tests/Hexalith.Parties.Platform.IntegrationTests/NativeDiagnosticBindingTests.cs
new file mode 100644
index 00000000..29d879ca
--- /dev/null
+++ b/tests/Hexalith.Parties.Platform.IntegrationTests/NativeDiagnosticBindingTests.cs
@@ -0,0 +1,120 @@
+namespace Hexalith.Parties.Platform.IntegrationTests;
+
+using System.Text.Json;
+
+using Shouldly;
+
+/// <summary>Uses the actual published mapping and explicitly local metadata controls, never a simulated CI owner.</summary>
+public sealed class NativeDiagnosticBindingTests
+{
+    /// <summary>Checks the surviving caller route and immutable cross-document refusals with GitHub variables absent.</summary>
+    /// <param name="mutation">The local metadata boundary to exercise.</param>
+    [Theory]
+    [InlineData("valid-local")]
+    [InlineData("foreign-run")]
+    [InlineData("foreign-attempt")]
+    [InlineData("changed-mapping")]
+    [InlineData("changed-context")]
+    [InlineData("foreign-model-output")]
+    [InlineData("lifecycle-local")]
+    [InlineData("lifecycle-foreign-receipt")]
+    [InlineData("lifecycle-foreign-source")]
+    public void PublishedMappingRoutesScrubbedLocalControlsAndRefusesMismatches(string mutation)
+    {
+        ArgumentNullException.ThrowIfNull(mutation);
+        Environment.GetEnvironmentVariable("GITHUB_ACTIONS").ShouldBeNull();
+        Environment.GetEnvironmentVariable("GITHUB_WORKSPACE").ShouldBeNull();
+        string prepared = Path.Combine(Path.GetDirectoryName(Environment.GetEnvironmentVariable("CustomAfterMicrosoftCommonProps"))!, "mapping.json");
+        using JsonDocument mapping = JsonDocument.Parse(File.ReadAllText(prepared));
+        string caller = mapping.RootElement.GetProperty("Root").GetString()!;
+        string hash = mapping.RootElement.GetProperty("ContentHash").GetString()!;
+        string control = Directory.CreateTempSubdirectory("parties-local-handoff-control-").FullName;
+        string workspace = Directory.CreateDirectory(Path.Combine(control, "workspace")).FullName;
+        string state = Directory.CreateDirectory(Path.Combine(control, "state")).FullName;
+        string run = Guid.NewGuid().ToString("N"), attempt = Guid.NewGuid().ToString("N"), environment = Guid.NewGuid().ToString("N");
+        string? retained = null;
+        try
+        {
+            Directory.CreateDirectory(Path.Combine(workspace, "source-mapping"));
+            Directory.CreateDirectory(Path.Combine(workspace, "native-tests"));
+            File.Copy(prepared, Path.Combine(workspace, "source-mapping", "mapping.json"));
+            File.WriteAllText(Path.Combine(workspace, "test-environment.json"), JsonSerializer.Serialize(new
+            {
+                bindings = new
+                {
+                    run = new { runId = run, ownerRunId = run, attemptId = attempt, environmentId = environment, role = "owner" },
+                    environment = new { executionContext = new { kind = "local" } },
+                },
+            }));
+            File.WriteAllText(Path.Combine(workspace, "plan.json"), JsonSerializer.Serialize(new
+            {
+                schema = "hexalith.g4-run-plan.v1", runId = run, workspace, resourceClaimStateDirectory = state,
+                attemptId = mutation == "foreign-attempt" ? Guid.NewGuid().ToString("N") : attempt, environmentId = environment,
+                sourceMappingHash = hash, sourceMapping = new { root = caller, contentHash = hash },
+                selectedTest = new { name = mutation.StartsWith("lifecycle-", StringComparison.Ordinal) ? "lifecycle-package" : "platform-package" },
+                platformModelAssemblyPath = Path.Combine(workspace, "hosts", mutation == "foreign-model-output" ? "unbound-output" : "platform-model", "Hexalith.Platform.Composition.dll"),
+            }));
+            File.WriteAllText(Path.Combine(state, run + ".json"), JsonSerializer.Serialize(new
+            {
+                schema = "hexalith.g4-run-state.v1", runId = run, workspace, attemptId = attempt, environmentId = environment,
+                executionContext = new { kind = mutation == "changed-context" ? "unsupported-local-control" : "local" },
+            }));
+            Dictionary<string, string> handoff = new(StringComparer.Ordinal)
+            {
+                ["HEXALITH_G4_RUN_ID"] = mutation == "foreign-run" ? Guid.NewGuid().ToString("N") : run,
+                ["HEXALITH_TEST_ENVIRONMENT_PATH"] = Path.Combine(workspace, "test-environment.json"),
+                ["HEXALITH_G4_PLAN_PATH"] = Path.Combine(workspace, "plan.json"),
+                ["HEXALITH_G4_TEST_REPORT_PATH"] = Path.Combine(workspace, "native-tests", "native.trx"),
+                ["HEXALITH_G4_SOURCE_MAPPING_PATH"] = Path.Combine(workspace, "source-mapping", "mapping.json"),
+                ["HEXALITH_SOURCE_MAPPING_HASH"] = mutation == "changed-mapping" ? new string('0', 64) : hash,
+            };
+            if (mutation != "valid-local" && !mutation.StartsWith("lifecycle-", StringComparison.Ordinal))
+            {
+                Should.Throw<InvalidDataException>(() => NativeDiagnosticBinding.Read(run, handoff));
+                return;
+            }
+            NativeDiagnosticBinding binding = NativeDiagnosticBinding.Read(run, handoff);
+            binding.CallerRoot.ShouldBe(caller);
+            binding.OwnerWorkspace.ShouldBe(workspace);
+            binding.ExecutionContext.GetProperty("kind").GetString().ShouldBe("local");
+            if (mutation.StartsWith("lifecycle-", StringComparison.Ordinal))
+            {
+                binding.ArtifactDirectory.ShouldBe(Path.Combine(caller, "TestResults", "ci-lifecycle"));
+                string role = Directory.CreateDirectory(Path.Combine(control, "hexalith-ci-qualification", "passing")).FullName;
+                string receipt = Path.Combine(role, "receipt.json");
+                File.WriteAllText(receipt, JsonSerializer.Serialize(new
+                {
+                    schema = "hexalith.module.ci-owner-receipt.v1", runId = run,
+                    attemptId = mutation == "lifecycle-foreign-receipt" ? Guid.NewGuid().ToString("N") : attempt,
+                    environmentId = environment, stateDirectory = state, executionContext = new { kind = "local" },
+                }));
+                string journal = Path.Combine(control, "observations.json");
+                File.WriteAllText(journal, JsonSerializer.Serialize(new
+                {
+                    schema = "hexalith.ci-lifecycle-qualification.v1", classification = "baseline-only",
+                    source = mutation == "lifecycle-foreign-source" ? new string('0', 40) : binding.Revision,
+                    mappingHash = hash, executionContext = new { kind = "local" },
+                    owners = new[] { new { label = "passing", receipt } },
+                }));
+                if (mutation != "lifecycle-local")
+                {
+                    Should.Throw<InvalidDataException>(() => binding.VerifyLifecycleArtifact(journal));
+                    return;
+                }
+                binding.VerifyLifecycleArtifact(journal);
+            }
+            else binding.ArtifactDirectory.ShouldBe(Path.Combine(caller, "TestResults", "module-integration"));
+            Directory.CreateDirectory(binding.ArtifactDirectory);
+            NativeAssemblyObservations.WritePrivateObservation(binding.ArtifactDirectory, "local-control-" + run, "{\"scope\":\"local-handoff-io-only\"}");
+            retained = Path.Combine(binding.ArtifactDirectory, "loaded-assemblies-local-control-" + run + ".json");
+            byte[] original = File.ReadAllBytes(retained);
+            Directory.Delete(workspace, recursive: true);
+            File.ReadAllBytes(retained).ShouldBe(original);
+        }
+        finally
+        {
+            if (retained is not null) File.Delete(retained);
+            Directory.Delete(control, recursive: true);
+        }
+    }
+}
