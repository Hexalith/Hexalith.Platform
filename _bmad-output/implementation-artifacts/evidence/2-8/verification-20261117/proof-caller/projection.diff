diff --git a/scripts/prepare-native-admin-ui-artifact.py b/scripts/prepare-native-admin-ui-artifact.py
new file mode 100644
index 00000000..b5e4ab5c
--- /dev/null
+++ b/scripts/prepare-native-admin-ui-artifact.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Qualify the private native UI artifact outside the root package catalog context."""
+
+import argparse
+import importlib.util
+import json
+import os
+import subprocess
+import time
+import xml.etree.ElementTree as ET
+from pathlib import Path
+
+SCRIPT_ROOT = Path(__file__).resolve().parent
+spec = importlib.util.spec_from_file_location("runtime_cohort", SCRIPT_ROOT / "validate-aspire-runtime-cohort.py")
+cohort = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(cohort)
+
+
+def evaluated_imports(project: Path, properties: list[str], environment: dict, output: Path) -> set[Path]:
+    """Read the resolved import boundaries emitted by MSBuild's evaluated preprocessor."""
+    subprocess.run(["dotnet", "msbuild", str(project), "-nologo", *properties, "-preprocess:" + str(output)],
+                   env=environment, check=True)
+    paths = {project.resolve()}
+    for _, comment in ET.iterparse(output, events=("comment",)):
+        lines = [line.strip() for line in (comment.text or "").splitlines() if line.strip()]
+        if len(lines) >= 3 and set(lines[0]) == {"="} and set(lines[-1]) == {"="}:
+            path = Path(lines[-2])
+            if path.is_absolute():
+                if not path.is_file():
+                    raise ValueError("An evaluated native UI import is unavailable: " + str(path))
+                paths.add(path.resolve())
+    return paths
+
+
+def prepare(owner: Path, output: Path, configuration: str, version: str, framework: str) -> None:
+    """Build the real application, then authenticate it before exposing its TargetPath."""
+    output = output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    manifest = output / "prepared.json"
+    target_file = output / "target.txt"
+    for previous in (manifest, target_file):
+        previous.unlink(missing_ok=True)
+    if version != "4.2.0":
+        raise ValueError("The mapped private native UI boundary requires the exact retained SDK 4.2.0")
+    project = owner.resolve() / "src/Hexalith.EventStore.Admin.UI/Hexalith.EventStore.Admin.UI.csproj"
+    if not project.is_file():
+        raise ValueError("The complete selected native Admin UI project is required")
+    # These imports authenticate Root's mapped projects against Root's catalog.
+    # The external application retains its original identity and owner imports;
+    # its private package artifact is authenticated below using official archives.
+    environment = os.environ.copy()
+    inherited_imports = set()
+    for name in ("CustomBeforeDirectoryBuildProps", "CustomAfterMicrosoftCommonProps",
+                 "CustomBeforeDirectoryBuildTargets", "CustomAfterDirectoryBuildTargets",
+                 "AfterMicrosoftNETSdkTargets", "HEXALITH_SOURCE_MAPPING_HASH", "Configuration"):
+        value = environment.pop(name, None)
+        if name not in {"HEXALITH_SOURCE_MAPPING_HASH", "Configuration"} and value:
+            inherited_imports.add(Path(value).resolve())
+    properties = ["-p:Configuration=" + configuration, "-p:HexalithUsePublishedSdkForHostedTests=true",
+                  "-p:HexalithEventStoreVersion=" + version, "-p:UseHexalithProjectReferences=false",
+                  "-p:UseNuGetDeps=true", "-p:StaticWebAssetsEnabled=false", "-p:CopyLocalLockFileAssemblies=true",
+                  "-p:UseArtifactsOutput=true", "-p:ArtifactsPath=" + str(output / "build"),
+                  "-p:HexalithPartiesRuntimeTargetFramework=" + framework,
+                  "-p:CustomAfterMicrosoftCommonProps=" + str(cohort.RUNTIME_PROFILE)]
+    subprocess.run(["dotnet", "restore", str(project), "-m:1", "-nr:false", "-warnaserror", *properties],
+                   env=environment, check=True)
+    metadata = json.loads(subprocess.check_output([
+        "dotnet", "msbuild", str(project), "-nologo", *properties,
+        "-getProperty:TargetPath,ProjectAssetsFile,Configuration,HexalithEventStoreVersion,TargetFramework,"
+        "HexalithPartiesRuntimeTargetFramework,CustomAfterMicrosoftCommonProps"], env=environment, text=True))
+    target = Path(metadata["Properties"]["TargetPath"]).resolve()
+    sources = cohort.native_ui_owner_sources(project.parent)
+    sources.update(evaluated_imports(project, properties, environment, output / "native-owner.expanded.proj"))
+    sources.update(path for path in owner.resolve().iterdir() if path.is_file()
+                   and (path.name.startswith("Directory.") or path.name in {".editorconfig", "global.json"}))
+    sources.update({Path(__file__).resolve(), SCRIPT_ROOT / "validate-aspire-runtime-cohort.py", cohort.RUNTIME_PROFILE})
+    # Bind the incoming authenticated context as provenance, although only Root's
+    # own build uses those imports. Never synthesize or modify a catalog view.
+    sources.update(inherited_imports)
+    for imported in inherited_imports:
+        sources.update(path for path in imported.parent.glob("SourceMapping.*") if path.is_file())
+        sources.update(path for name in ("mapping.json", "catalog-versions.json")
+                       if (path := imported.parent / name).is_file())
+    original = {path: cohort.digest(path) for path in sources}
+    started = time.time_ns()
+    subprocess.run(["dotnet", "build", str(project), "--no-restore", "-t:Rebuild", "-m:1", "-nr:false", "-warnaserror", *properties],
+                   env=environment, check=True)
+    if cohort.native_ui_owner_sources(project.parent) != {path for path in sources if path.is_relative_to(project.parent)} \
+            or any(cohort.digest(path) != expected for path, expected in original.items()):
+        raise ValueError("Native Admin UI source inputs changed during compilation")
+    # This inventory is checked again by the ordinary runtime receipt reader.
+    provenance = target.parent / "native-admin-ui-artifact.tsv"
+    provenance.write_text("nativeSourceDirectory|" + str(project.parent) + "\n" + "\n".join(
+        str(path) + "|" + original[path] for path in sorted(sources)) + "\n", encoding="utf-8")
+    receipt = output / "native-owner.json"
+    cohort.write(receipt, cohort.record(metadata, project, configuration, version, started, "runtime", {}, target_framework=framework))
+    cohort.write(manifest, cohort.complete([receipt], configuration, version, [], output / "public-archives", {}, framework))
+    qualified = cohort.verify_manifest(manifest, project, configuration, version, {}, framework)
+    evidence = {Path(path) for path in qualified["files"]} | {manifest, receipt}
+    evidence.update(Path(archive["path"]) for archive in cohort.load(manifest)["publicArchives"])
+    (output / "evidence.txt").write_text("\n".join(str(path) for path in sorted(evidence)) + "\n", encoding="utf-8")
+    target_file.write_text(str(target) + "\n", encoding="utf-8")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--owner-root", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--configuration", choices=("Debug", "Release"), required=True)
+    parser.add_argument("--version", required=True)
+    parser.add_argument("--target-framework", choices=("net10.0", "net11.0"), required=True)
+    args = parser.parse_args()
+    try:
+        prepare(args.owner_root, args.output, args.configuration, args.version, args.target_framework)
+    except (OSError, ValueError, KeyError, TypeError, ET.ParseError, subprocess.CalledProcessError) as failure:
+        parser.exit(1, "Private native Admin UI qualification failed: " + str(failure) + "\n")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/story-2-8-proof-observer.py b/scripts/story-2-8-proof-observer.py
new file mode 100644
index 00000000..2dc823c9
--- /dev/null
+++ b/scripts/story-2-8-proof-observer.py
@@ -0,0 +1,205 @@
+"""Proof branch only (Story 2.8 review loop 2; never merged).
+
+Records, in one job, the order of three durable events for the BS-4 hosted proofs:
+1. the owner's admission-closing status write (owner state and first outcome);
+2. the attachment withdrawal commit;
+3. the first stop of a composed resource: a Docker kill/stop/die of a container created by this owner, a kernel
+   signal_generate event (SIGHUP/INT/QUIT/KILL/TERM) aimed at a process carrying the owner's run tag or descending
+   from one, or such a process disappearing.
+It never records environment values, command lines or credentials: only process roles, pids and times.
+"""
+import json
+import os
+import pathlib
+import shutil
+import subprocess
+import sys
+import time
+
+MODE = sys.argv[1]
+assert MODE in ('v2', 'lifecycle')
+WORKSPACE = pathlib.Path(os.environ['GITHUB_WORKSPACE'])
+RUNNER_TEMP = pathlib.Path(os.environ['RUNNER_TEMP'])
+OUT = RUNNER_TEMP / 'story-2-8-proof'
+OUT.mkdir(exist_ok=True)
+MIRROR = WORKSPACE / 'TestResults' / ('module-integration' if MODE == 'v2' else 'story-2-8-proof-observer') / 'story-2-8-proof'
+STATE = pathlib.Path(os.environ.get('XDG_DATA_HOME', str(pathlib.Path.home() / '.local' / 'share'))) / 'hexalith-builds' / 'g4-runs'
+TAG = b'HEXALITH_G4_RUN_ID='
+MARKER = pathlib.Path('/tmp/story-2-8-proof-native-live')
+log = open(OUT / 'observer.jsonl', 'a', buffering=1)
+
+
+def record(kind, **fields):
+    log.write(json.dumps({'kind': kind, 'wallNs': time.time_ns(), 'monoNs': time.monotonic_ns(), **fields}, sort_keys=True) + '\n')
+
+
+def sudo(script):
+    return subprocess.run(['sudo', '-n', 'sh', '-c', script], capture_output=True, text=True, timeout=30)
+
+
+def start_trace():
+    found = sudo('for d in /sys/kernel/tracing /sys/kernel/debug/tracing; do [ -e "$d/trace_pipe" ] && echo "$d" && exit 0; done; '
+                 'mount -t tracefs nodev /sys/kernel/tracing && echo /sys/kernel/tracing')
+    base = found.stdout.strip().splitlines()[-1] if found.returncode == 0 and found.stdout.strip() else ''
+    if not base:
+        record('trace-unavailable', code=found.returncode)
+        return None
+    setup = sudo(f'cd {base} && echo 0 > tracing_on && echo mono > trace_clock && echo > trace && '
+                 "echo 'sig==1||sig==2||sig==3||sig==9||sig==15' > events/signal/signal_generate/filter && "
+                 'echo 1 > events/signal/signal_generate/enable && echo 1 > tracing_on')
+    record('trace-started', base=base, code=setup.returncode, clock='mono')
+    if setup.returncode:
+        return None
+    return subprocess.Popen(['sudo', '-n', 'cat', base + '/trace_pipe'], stdout=open(OUT / 'signals.trace', 'ab'),
+                            stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL, start_new_session=True), base
+
+
+def stat(pid):
+    try:
+        fields = pathlib.Path(f'/proc/{pid}/stat').read_text(errors='replace').rpartition(')')[2].split()
+        return int(fields[1]), int(fields[3]), fields[19]
+    except (OSError, IndexError, ValueError):
+        return None
+
+
+def role(pid):
+    """A coarse role from argv[0..2] basenames only; the command line itself is never retained."""
+    try:
+        argv = pathlib.Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')[:3]
+    except OSError:
+        return None
+    names = [os.path.basename(part.decode(errors='replace')) for part in argv if part]
+    text = ' '.join(names).lower()
+    for needle, label in (('hexalith-module', 'tool-or-muxer'), ('apphost', 'apphost'), ('dcp', 'dcp'), ('daprd', 'daprd'),
+                          ('testhost', 'native-test-host'), ('integrationtests', 'native-test-host'), ('placement', 'dapr-placement'),
+                          ('scheduler', 'dapr-scheduler'), ('dotnet', 'dotnet')):
+        if needle in text:
+            return label
+    return names[0][:40] if names else None
+
+
+def tagged(pid):
+    try:
+        for entry in pathlib.Path(f'/proc/{pid}/environ').read_bytes().split(b'\0'):
+            if entry.startswith(TAG):
+                return entry[len(TAG):].decode('ascii', 'replace')[:32]
+    except OSError:
+        return None
+    return None
+
+
+known, composed, states, files = {}, set(), {}, {}
+attached = False
+trace = start_trace()
+docker = subprocess.Popen(['docker', 'events', '--format', '{{json .}}', '--filter', 'type=container'],
+                          stdout=open(OUT / 'docker-events.jsonl', 'ab'), stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
+                          start_new_session=True)
+record('observer-started', mode=MODE, pid=os.getpid())
+deadline = time.monotonic() + 75 * 60
+last_mirror = last_clock = 0.0
+finished_at = None
+while time.monotonic() < deadline:
+    now = time.monotonic()
+    live = set()
+    for entry in os.scandir('/proc'):
+        if not entry.name.isdigit():
+            continue
+        pid = int(entry.name)
+        live.add(pid)
+        if pid in known:
+            continue
+        identity = stat(pid)
+        if identity is None:
+            continue
+        parent, session, start = identity
+        tag = tagged(pid)
+        is_composed = tag is not None or parent in composed
+        info = {'pid': pid, 'parent': parent, 'session': session, 'startTime': start, 'role': role(pid), 'runTag': tag,
+                'composed': is_composed}
+        known[pid] = info
+        if is_composed:
+            composed.add(pid)
+        if is_composed or info['role'] in ('tool-or-muxer', 'native-test-host'):
+            record('process-seen', **info)
+    for pid in [pid for pid in known if pid not in live]:
+        info = known.pop(pid)
+        if info['composed'] or info['role'] in ('tool-or-muxer', 'native-test-host'):
+            record('process-gone', **info)
+    for path in STATE.glob('*.json') if STATE.is_dir() else []:
+        try:
+            value = json.loads(path.read_text())
+        except (OSError, ValueError):
+            continue
+        if not isinstance(value, dict):
+            continue
+        test_run = value.get('testRun') or {}
+        summary = (value.get('status'), value.get('cleanupDisposition'), test_run.get('terminalStatus'))
+        if states.get(path.name) != summary:
+            states[path.name] = summary
+            record('owner-state', runId=value.get('runId'), status=summary[0], cleanupDisposition=summary[1],
+                   terminalStatus=summary[2], updatedAt=value.get('updatedAt'))
+        run_id = value.get('runId')
+        for name in ('attachments.json', 'attachment-withdrawals.json', 'test-result.json'):
+            candidate = STATE / 'diagnostics' / str(run_id) / name
+            try:
+                mtime = candidate.stat().st_mtime_ns
+            except OSError:
+                continue
+            if files.get(str(candidate)) != mtime:
+                files[str(candidate)] = mtime
+                record('owner-file', runId=run_id, name=name, mtimeNs=mtime)
+        if (MODE == 'v2' and not attached and value.get('status') == 'Ready' and MARKER.exists()
+                and isinstance(run_id, str) and isinstance(value.get('manifestHash'), str)):
+            attached = True
+            record('attach-requested', runId=run_id)
+            command = ['dotnet', 'tool', 'run', 'hexalith-module', '--', 'attach', '--owner-run-id=' + run_id, '--mode=package',
+                       '--composition-identity=' + value['manifestHash'], '--hold-seconds=900', '--output=json']
+            try:
+                completed = subprocess.run(command, cwd=WORKSPACE, capture_output=True, text=True, timeout=120,
+                                           stdin=subprocess.DEVNULL, start_new_session=True)
+                try:
+                    result = json.loads(completed.stdout)
+                except ValueError:
+                    result = None
+                attachment = (result or {}).get('attachment') if isinstance(result, dict) else None
+                record('attach-result', exitCode=completed.returncode, attachment=attachment,
+                       outcome=(result or {}).get('outcome') if isinstance(result, dict) else None)
+            except (OSError, subprocess.SubprocessError) as error:
+                record('attach-failed', error=type(error).__name__)
+    if now - last_clock >= 1:
+        last_clock = now
+        record('clock')
+    done = False
+    if MODE == 'v2':
+        evidence = WORKSPACE / 'TestResults' / 'module-integration'
+        for cleanup in evidence.glob('cleanup-*.json') if evidence.is_dir() else []:
+            try:
+                value = json.loads(cleanup.read_text())
+            except (OSError, ValueError):
+                continue
+            done = done or (value.get('jobStatus') == 'cancelled' and value.get('status') in ('completed', 'timed-out', 'tool-unavailable'))
+    else:
+        done = (WORKSPACE / 'TestResults' / 'ci-lifecycle' / 'cancel-independent-finalizer.json').exists()
+    if done and finished_at is None:
+        finished_at = now
+        record('finalizer-observed')
+    if now - last_mirror >= 0.5 or (finished_at is not None and now - finished_at >= 3):
+        last_mirror = now
+        if MIRROR.parent.is_dir() or MODE == 'lifecycle':
+            MIRROR.mkdir(parents=True, exist_ok=True)
+            for name in ('observer.jsonl', 'signals.trace', 'docker-events.jsonl'):
+                if (OUT / name).exists():
+                    shutil.copyfile(OUT / name, MIRROR / name)
+    if finished_at is not None and now - finished_at >= 3:
+        break
+    time.sleep(0.05)
+record('observer-stopping')
+if trace:
+    sudo(f'echo 0 > {trace[1]}/tracing_on')
+    subprocess.run(['sudo', '-n', 'kill', str(trace[0].pid)], capture_output=True)
+docker.terminate()
+time.sleep(0.5)
+MIRROR.mkdir(parents=True, exist_ok=True)
+for name in ('observer.jsonl', 'signals.trace', 'docker-events.jsonl'):
+    if (OUT / name).exists():
+        shutil.copyfile(OUT / name, MIRROR / name)
