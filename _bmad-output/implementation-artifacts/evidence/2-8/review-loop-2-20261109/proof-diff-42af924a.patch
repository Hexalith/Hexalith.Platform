+name: Story 2.8 v2 late-startup cancellation proof
+
+# Proof branch only; never merged. One push runs one v2 caller of the patched Builds domain-ci-v2.yml at bde7fd4f, whose
+# integration step is cancelled once late in startup while the AppHost, DCP and owned containers are live
+# (Story 2.8 review loop 2, BS-4 second owner amendment). Tool, gitlinks, manifest, suites and tests are unchanged.
+on:
+  push:
+    branches: ['proof/story-2-8-v2-late-startup-*']
+
+permissions:
+  contents: read
+
+concurrency:
+  group: story-2-8-v2-late-startup-proof-${{ github.run_id }}
+  cancel-in-progress: false
+
+jobs:
+  ci:
+    uses: Hexalith/Hexalith.Builds/.github/workflows/domain-ci-v2.yml@bde7fd4f875ae147c0631b97c349ef9b73561ed4
+    with:
+      solution: Hexalith.Parties.Standalone.slnx
+      module-manifest: module/hexalith.module-manifest.v2.json
+      integration-test-profiles: platform-package
+      package-prepare-script: scripts/prepare-ci-package-dependencies.sh
+      test-platform: microsoft-testing-platform
+      run-consumer-validation: false
+      run-coverage-gate: false
+      unit-test-projects: |
+        tests/Hexalith.Parties.Aspire.Tests
+      build-timeout-minutes: 60
+    secrets:
+      registry-pull-username: ${{ secrets.HEXALITH_CI_REGISTRY_USERNAME }}
+      registry-pull-password: ${{ secrets.HEXALITH_CI_REGISTRY_PASSWORD }}
