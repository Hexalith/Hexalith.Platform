+++ b/tests/Hexalith.Parties.Platform.IntegrationTests/Story28ProofExecutionHoldTests.cs
@@ -0,0 +1,14 @@
+namespace Hexalith.Parties.Platform.IntegrationTests;
+
+/// <summary>Proof branch only (Story 2.8 loop 2, never merged): keeps one native test live for a single cancellation.</summary>
+public sealed class Story28ProofExecutionHoldTests
+{
+    /// <summary>Marks native execution as live, then stays live until the owner's cancellation stops it.</summary>
+    /// <returns>The bounded wait.</returns>
+    [Fact]
+    public async Task HoldsNativeExecutionLiveForTheCancellationProofAsync()
+    {
+        await File.WriteAllTextAsync("/tmp/story-2-8-proof-native-live", DateTimeOffset.UtcNow.ToString("O", System.Globalization.CultureInfo.InvariantCulture), TestContext.Current.CancellationToken).ConfigureAwait(true);
+        await Task.Delay(TimeSpan.FromSeconds(840), TestContext.Current.CancellationToken).ConfigureAwait(true);
+    }
+}
