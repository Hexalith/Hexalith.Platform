{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {"enum": ["normal", "recovery", "remove-workloads"]},
    "sourceRevision": {"type": "string"},
    "replicas": {"type": "integer", "minimum": 1, "maximum": 3},
    "image": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "repository": {"const": "registry.hexalith.com/timesheets"},
        "digest": {"type": "string"},
        "pullSecretName": {"$ref": "#/definitions/name"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "authority": {"type": "string"}, "issuer": {"type": "string"},
        "audience": {"type": "string"}, "tokenEndpoint": {"type": "string"},
        "allowedAlgorithms": {"type": "array", "items": {"type": "string"}},
        "workloadAuthority": {"type": "string"}, "workloadIssuer": {"type": "string"},
        "workloadAllowedAlgorithms": {"type": "array", "items": {"type": "string"}},
        "secretName": {"$ref": "#/definitions/name"},
        "clientIdKey": {"$ref": "#/definitions/key"},
        "clientSecretKey": {"$ref": "#/definitions/key"}
      }
    },
    "dapr": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "configuration": {"const": "timesheets"},
        "appTokenSecretName": {"$ref": "#/definitions/name"},
        "apiTokenSecretName": {"$ref": "#/definitions/name"}
      }
    },
    "ingress": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}, "hostname": {"const": "timesheets.hexalith.com"},
        "gateway": {
          "type": "object", "additionalProperties": false,
          "properties": {"name": {"$ref": "#/definitions/name"}, "namespace": {"const": "hexalith-staging-data"}, "sectionName": {"$ref": "#/definitions/name"}}
        }
      }
    },
    "resources": {"type": "object"}
  },
  "additionalProperties": false,
  "definitions": {
    "name": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
    "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-zA-Z0-9._-]+$"}
  }
}
