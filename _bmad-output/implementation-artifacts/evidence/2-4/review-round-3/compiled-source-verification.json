  "toolSource": "using System.Reflection.Metadata;\nusing System.Reflection.PortableExecutable;\nusing System.Security.Cryptography;\nusing System.Text.Json;\n\nusing var binaryStream = File.OpenRead(args[0]);\nusing var pe = new PEReader(binaryStream);\nusing var pdbStream = File.OpenRead(args[1]);\nusing var provider = MetadataReaderProvider.FromPortablePdbStream(pdbStream);\nvar reader = provider.GetMetadataReader();\nGuid id = new(reader.DebugMetadataHeader!.Id.Take(16).ToArray());\nvar codeView = pe.ReadCodeViewDebugDirectoryData(pe.ReadDebugDirectory().Single(entry => entry.Type == DebugDirectoryEntryType.CodeView));\nif (codeView.Guid != id) throw new InvalidDataException(\"Binary and portable PDB identities differ.\");\nList<object> files = [];\nforeach (string source in args.Skip(2))\n{\n    var document = reader.Documents.Select(handle => reader.GetDocument(handle)).Single(item => Path.GetFileName(reader.GetString(item.Name)) == Path.GetFileName(source));\n    Guid algorithm = reader.GetGuid(document.HashAlgorithm);\n    if (algorithm != new Guid(\"8829d00f-11b8-4213-878b-770e8597ac16\")) throw new InvalidDataException(\"Expected SHA-256 source checksum.\");\n    string compiled = Convert.ToHexStringLower(reader.GetBlobBytes(document.Hash));\n    string current = Convert.ToHexStringLower(SHA256.HashData(File.ReadAllBytes(source)));\n    files.Add(new { source, document = reader.GetString(document.Name), algorithm = \"SHA-256\", compiled, current, matches = compiled == current });\n    if (compiled != current) throw new InvalidDataException(\"Current source differs from compiled source: \" + Path.GetFileName(source));\n}\nConsole.WriteLine(JsonSerializer.Serialize(new { binary = args[0], binarySha256 = Convert.ToHexStringLower(SHA256.HashData(File.ReadAllBytes(args[0]))), pdb = args[1], pdbSha256 = Convert.ToHexStringLower(SHA256.HashData(File.ReadAllBytes(args[1]))), matchedBinaryPdbIdentity = id, files }));\n",
